
<Window x:Class="Mercadex.Desktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Mercadex.Desktop.App.ViewModels"
        xmlns:views="clr-namespace:Mercadex.Desktop.App.Views"
        Title="Mercadex"
        Height="760"
        Width="1180"
        MinHeight="620"
        MinWidth="900"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

                <!-- MENU LATERAL MODERNO -->

        <Border Grid.Column="0"
                Background="{StaticResource Mx.SidebarBrush}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- MARCA -->
                <Border Grid.Row="0"
                        Padding="18,19,12,17"
                        BorderBrush="#365875"
                        BorderThickness="0,0,0,1">

                    <StackPanel>
                        <TextBlock Text="MERCADEX"
                                   Foreground="White"
                                   FontSize="23"
                                   FontWeight="Bold"/>

                        <TextBlock Text="GESTION COMERCIAL"
                                   Foreground="#B5CDE2"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="1,4,0,0"/>
                    </StackPanel>

                </Border>

                <!-- NAVEGACION -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="10,12,10,12">

                    <RadioButton GroupName="MenuMercadex"
                                 Style="{StaticResource Mx.NavRadio}"
                                 Command="{Binding MostrarDashboardCommand}"
                                 IsChecked="True">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xE80F;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Width="30"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="MenuMercadex"
                                 Style="{StaticResource Mx.NavRadio}"
                                 Command="{Binding MostrarCajaCommand}"
                                 >
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xE8D4;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Width="30"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Caja"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="MenuMercadex"
                                 Style="{StaticResource Mx.NavRadio}"
                                 Command="{Binding MostrarObligacionesCommand}"
                                 >
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xE8A5;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Width="30"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Obligaciones"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="MenuMercadex"
                                 Style="{StaticResource Mx.NavRadio}"
                                 Command="{Binding MostrarIngresosCommand}"
                                 >
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xE8FB;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Width="30"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Ingresos"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="MenuMercadex"
                                 Style="{StaticResource Mx.NavRadio}"
                                 Command="{Binding MostrarEgresosCommand}"
                                 >
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xE8D0;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Width="30"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Gastos / Egresos"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="MenuMercadex"
                                 Style="{StaticResource Mx.NavRadio}"
                                 Command="{Binding MostrarSociosCommand}"
                                 >
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Width="30"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Socios"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="MenuMercadex"
                                 Style="{StaticResource Mx.NavRadio}"
                                 Command="{Binding MostrarCasetasCommand}"
                                 >
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xE80A;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Width="30"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Casetas"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="MenuMercadex"
                                 Style="{StaticResource Mx.NavRadio}"
                                 Command="{Binding MostrarRecibosCommand}"
                                 >
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xE8A1;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Width="30"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Recibos"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="MenuMercadex"
                                 Style="{StaticResource Mx.NavRadio}"
                                 Command="{Binding MostrarReportesCommand}"
                                 >
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xE9D2;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Width="30"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Reportes"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="MenuMercadex"
                                 Style="{StaticResource Mx.NavRadio}"
                                 Command="{Binding MostrarKardexCommand}"
                                 >
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xE8B7;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Width="30"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Kardex"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    </StackPanel>
                </ScrollViewer>

                <!-- PIE -->
                <Border Grid.Row="2"
                        BorderBrush="#365875"
                        BorderThickness="0,1,0,0"
                        Padding="18,13">

                    <StackPanel>
                        <TextBlock Text="MERCADEX"
                                   Foreground="#C2D5E5"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Sistema de administración"
                                   Foreground="#93ADC4"
                                   FontSize="10"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                </Border>
            </Grid>
        </Border>
<!-- CONTENIDO PRINCIPAL -->

        <Border Grid.Column="1"
                Background="{StaticResource Mx.SurfaceBrush}">

            <ContentControl Content="{Binding CurrentView}">

                <ContentControl.Resources>

                    <DataTemplate DataType="{x:Type views:DashboardView}">
                        <views:DashboardView/>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type views:CajaView}">
                        <views:CajaView/>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type views:ObligacionesView}">
                        <views:ObligacionesView/>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type views:IngresosView}">
                        <views:IngresosView/>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type views:SociosView}">
                        <views:SociosView/>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type views:CasetasView}">
                        <views:CasetasView/>
                    </DataTemplate>

                </ContentControl.Resources>

            </ContentControl>

        </Border>

    </Grid>

</Window>
