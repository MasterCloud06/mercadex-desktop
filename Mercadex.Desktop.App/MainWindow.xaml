
<Window x:Class="Mercadex.Desktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Mercadex.Desktop.App.ViewModels"
        xmlns:views="clr-namespace:Mercadex.Desktop.App.Views"
        Title="Mercadex"
        Height="760"
        Width="1180"
        MinHeight="620"
        MinWidth="900"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown" FontFamily="{StaticResource Mx.Font}" Background="{StaticResource Mx.SurfaceBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColumnaMenu" Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENÚ LATERAL -->

        <Border Grid.Column="0" Background="{StaticResource Mx.SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- MARCA: cuadro amarillo como sello + nombre -->
                <StackPanel Grid.Row="0">
                <StackPanel x:Name="Marca" Orientation="Horizontal" Margin="15,22,12,8">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource Mx.AccentBrush}">
                        <TextBlock Text="M" FontSize="19" FontWeight="Bold" Foreground="#163A5B"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                    </Border>
                    <StackPanel x:Name="MarcaTexto" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Mercadex" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="Gestión del mercado" Foreground="#8FA9C1" FontSize="11.5" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Actualizar la pantalla (F5) y esconder el menú -->
                <StackPanel x:Name="BarraMenu" Orientation="Horizontal" Margin="10,0,10,4">
                    <Button x:Name="BtnRecargar" Click="Recargar_Click" Style="{StaticResource Mx.ButtonBase}" Background="Transparent"
                            BorderBrush="Transparent" Foreground="#B9CCDD" Height="30" Padding="6,0" Margin="0,0,2,0" Cursor="Hand"
                            ToolTip="Volver a cargar los datos de esta pantalla (F5)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="20" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtRecargar" Text="Actualizar" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnPlegar" Click="Plegar_Click" Style="{StaticResource Mx.ButtonBase}" Background="Transparent"
                            BorderBrush="Transparent" Foreground="#B9CCDD" Height="30" Padding="6,0" Cursor="Hand"
                            ToolTip="Esconder el menú para tener más espacio">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="IconoPlegar" Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="20" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtPlegar" Text="Ocultar" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                </StackPanel>

                <!-- NAVEGACIÓN, agrupada como trabaja la asociación -->
                <ScrollViewer Grid.Row="1" x:Name="MenuScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,8,0,12">
                        <!-- Cobro rápido: ir directo a cobrar una caseta desde cualquier pantalla -->
                        <Button x:Name="BtnCobroRapido" Click="CobroRapido_Click" Margin="14,4,14,10" Height="40" Padding="12,0"
                                HorizontalContentAlignment="Stretch" Background="#F2B705" BorderBrush="#F2B705"
                                Foreground="#163A5B" Style="{StaticResource Mx.ButtonBase}"
                                ToolTip="Escribe el número de caseta y cobra (Ctrl + K)">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="Ctrl K" FontSize="11.5" FontWeight="Normal"
                                           Opacity="0.75" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="Cobro rápido" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Button>
                        <RadioButton GroupName="MenuMercadex" Style="{StaticResource Mx.NavRadio}" Command="{Binding MostrarDashboardCommand}" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center"/>
                                <TextBlock Text="Inicio" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="MenuMercadex" Style="{StaticResource Mx.NavRadio}" Command="{Binding MostrarMapaCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center"/>
                                <TextBlock Text="Mapa del mercado" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <TextBlock Text="Socios y casetas" Style="{StaticResource Mx.NavGroup}"/>
                        <RadioButton x:Name="NavSocios" GroupName="MenuMercadex" Style="{StaticResource Mx.NavRadio}" Command="{Binding MostrarSociosCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center"/>
                                <TextBlock Text="Socios" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavCasetas" GroupName="MenuMercadex" Style="{StaticResource Mx.NavRadio}" Command="{Binding MostrarCasetasCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center"/>
                                <TextBlock Text="Casetas" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavKardex" GroupName="MenuMercadex" Style="{StaticResource Mx.NavRadio}" Command="{Binding MostrarKardexCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center"/>
                                <TextBlock Text="Kardex" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <TextBlock Text="Cobranza" Style="{StaticResource Mx.NavGroup}"/>
                        <RadioButton x:Name="NavObligaciones" GroupName="MenuMercadex" Style="{StaticResource Mx.NavRadio}" Command="{Binding MostrarObligacionesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center"/>
                                <TextBlock Text="Obligaciones" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavIngresos" GroupName="MenuMercadex" Style="{StaticResource Mx.NavRadio}" Command="{Binding MostrarIngresosCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center"/>
                                <TextBlock Text="Cobrar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavPagosQr" GroupName="MenuMercadex" Style="{StaticResource Mx.NavRadio}" Command="{Binding MostrarPagosQrCommand}">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="&#xED14;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center"/>
                                <TextBlock Text="Pagos QR" VerticalAlignment="Center"/>
                                <Border x:Name="BadgePagosQr" Visibility="Collapsed" Background="#F2B705" CornerRadius="9" MinWidth="20" Height="19"
                                        Padding="6,0" Margin="10,0,0,0" VerticalAlignment="Center"
                                        ToolTip="Pagos QR de la app por revisar">
                                    <TextBlock x:Name="TxtPagosQr" Text="0" FontSize="11.5" FontWeight="Bold" Foreground="#163A5B"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </DockPanel>
                        </RadioButton>
                        <RadioButton GroupName="MenuMercadex" Style="{StaticResource Mx.NavRadio}" Command="{Binding MostrarRecibosCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center"/>
                                <TextBlock Text="Recibos" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="MenuMercadex" Style="{StaticResource Mx.NavRadio}" Command="{Binding MostrarCajaCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center"/>
                                <TextBlock Text="Cierre de caja" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <TextBlock Text="Finanzas" Style="{StaticResource Mx.NavGroup}"/>
                        <RadioButton GroupName="MenuMercadex" Style="{StaticResource Mx.NavRadio}" Command="{Binding MostrarEgresosCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D0;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center"/>
                                <TextBlock Text="Gastos y egresos" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="MenuMercadex" Style="{StaticResource Mx.NavRadio}" Command="{Binding MostrarReportesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center"/>
                                <TextBlock Text="Reportes" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavComunicados" GroupName="MenuMercadex" Style="{StaticResource Mx.NavRadio}" Command="{Binding MostrarComunicadosCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE789;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center"/>
                                <TextBlock Text="Comunicados" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <TextBlock x:Name="GrupoAdministracion" Text="Administración" Style="{StaticResource Mx.NavGroup}"/>
                        <RadioButton x:Name="NavConceptos" GroupName="MenuMercadex" Style="{StaticResource Mx.NavRadio}" Command="{Binding MostrarConceptosCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center"/>
                                <TextBlock Text="Conceptos de cobro" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavUsuarios" GroupName="MenuMercadex" Style="{StaticResource Mx.NavRadio}" Command="{Binding MostrarUsuariosCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center"/>
                                <TextBlock Text="Usuarios" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavRegistroCambios" GroupName="MenuMercadex" Style="{StaticResource Mx.NavRadio}" Command="{Binding MostrarRegistroCambiosCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center"/>
                                <TextBlock Text="Registro de cambios" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- PIE -->
                <Border x:Name="PieMenu" Grid.Row="2" BorderBrush="#24496C" BorderThickness="0,1,0,0" Padding="20,12,14,14">
                    <StackPanel>
                        <!-- Usuario con sesión iniciada -->
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="16" Background="#24496C" VerticalAlignment="Center">
                                <TextBlock x:Name="UsuarioInicial" Text="?" Foreground="White" FontWeight="SemiBold" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="UsuarioNombre" Text="" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="UsuarioRol" Text="" Foreground="#8FA9C1" FontSize="11.5"/>
                            </StackPanel>
                        </DockPanel>
                        <WrapPanel Margin="0,10,0,8">
                            <Button x:Name="BtnCambiarContrasena" Content="Cambiar contraseña" Click="CambiarContrasena_Click"
                                    Style="{StaticResource Mx.NavLink}" Margin="0,0,14,0"/>
                            <Button Content="Cerrar sesión" Click="CerrarSesion_Click" Style="{StaticResource Mx.NavLink}"/>
                        </WrapPanel>
                        <TextBlock x:Name="VersionTexto" Text="Versión" Foreground="#7F9BB5" FontSize="11.5"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

<!-- CONTENIDO PRINCIPAL -->

        <Border Grid.Column="1"
                Background="{StaticResource Mx.SurfaceBrush}">

            <ContentControl Content="{Binding CurrentView}">

                <ContentControl.Resources>

                    <DataTemplate DataType="{x:Type views:DashboardView}">
                        <views:DashboardView/>
                    </DataTemplate>






                </ContentControl.Resources>

            </ContentControl>

        </Border>


        <!-- AVISO: llegó un pago QR desde la app de socios -->
        <Border x:Name="AvisoPagoQr" Grid.ColumnSpan="2" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,24" Width="350" Background="White" CornerRadius="12" BorderBrush="#F2B705" BorderThickness="2" Padding="18,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="#102236"/>
            </Border.Effect>
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="&#xED14;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#163A5B" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TituloAvisoPagoQr" Text="Nuevo pago QR" FontSize="16" FontWeight="SemiBold" Foreground="#163A5B" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="TxtAvisoPagoQr" TextWrapping="Wrap" Foreground="#31465A" Margin="0,8,0,12" FontSize="13.5"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Más tarde" Click="AvisoPagoQr_Cerrar" Style="{StaticResource Mx.SecondaryButton}" Height="34" Padding="14,0" Margin="0,0,8,0"/>
                    <Button Content="Revisar ahora" Click="AvisoPagoQr_Revisar" Style="{StaticResource Mx.PrimaryButton}" Height="34" Padding="14,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- COBRO RÁPIDO (Ctrl + K) -->
        <Grid x:Name="CapaCobroRapido" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#99102236"
              MouseLeftButtonDown="CapaCobroRapido_MouseLeftButtonDown">
            <Border Width="440" VerticalAlignment="Top" Margin="0,120,0,0" Background="White"
                    CornerRadius="14" Padding="24,20" MouseLeftButtonDown="TarjetaCobroRapido_MouseLeftButtonDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.25" Color="#0B1F33"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Cobro rápido" FontSize="20" FontWeight="SemiBold" Foreground="#12304D"/>
                    <TextBlock Text="Escribe el número de caseta y presiona Enter." Foreground="#5A6B7D" Margin="0,4,0,14"/>
                    <TextBox x:Name="TxtCobroRapido" Height="46" FontSize="20" MaxLength="20"
                             KeyDown="TxtCobroRapido_KeyDown"/>
                    <TextBlock Text="Esc para cerrar" Foreground="#8696A7" FontSize="12" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>

</Window>
