<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        MERCADEX · TEMA VISUAL

        Azul institucional como base, superficie gris muy claro y blanco
        para el contenido. Un único acento cálido (amarillo maíz) marca
        "dónde estoy": la opción activa del menú y el foco del teclado.

        Las claves Mx.* existentes se conservan: muchas pantallas las usan.
        Los estilos implícitos (sin x:Key) modernizan todos los controles
        de la aplicación sin tocar cada pantalla.
    -->

    <!-- ==================== COLORES ==================== -->

    <Color x:Key="PrimaryColor">#1F4E79</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>

    <SolidColorBrush x:Key="Mx.SidebarBrush"     Color="#163A5B"/>
    <SolidColorBrush x:Key="Mx.PrimaryBrush"     Color="#1F4E79"/>
    <SolidColorBrush x:Key="Mx.PrimaryDarkBrush" Color="#173E61"/>
    <SolidColorBrush x:Key="Mx.SurfaceBrush"     Color="#F3F6FA"/>
    <SolidColorBrush x:Key="Mx.BorderBrush"      Color="#E1E7EF"/>
    <SolidColorBrush x:Key="Mx.InputBorderBrush" Color="#C9D3DF"/>
    <SolidColorBrush x:Key="Mx.InkBrush"         Color="#12304D"/>
    <SolidColorBrush x:Key="Mx.TextBrush"        Color="#1E2A38"/>
    <SolidColorBrush x:Key="Mx.MutedBrush"       Color="#5A6B7D"/>
    <SolidColorBrush x:Key="Mx.AccentBrush"      Color="#F2B705"/>
    <SolidColorBrush x:Key="Mx.HoverBrush"       Color="#EEF3F9"/>
    <SolidColorBrush x:Key="Mx.SelectedBrush"    Color="#DFEAF6"/>

    <FontFamily x:Key="Mx.Font">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Anillo de foco: solo aparece al navegar con el teclado (Tab),
         no al hacer clic con el mouse. -->
    <Style x:Key="Mx.FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="#F2B705" BorderThickness="2" CornerRadius="9" Margin="-2" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Mx.FocusRingNav">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="#F2B705" BorderThickness="1.5" CornerRadius="7" Margin="8,0" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== BOTONES ==================== -->

    <!-- Plantilla común: el color se oscurece al pasar el mouse
         (capa translúcida) en vez de volverse transparente. -->
    <ControlTemplate x:Key="Mx.ButtonTemplate" TargetType="Button">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"/>
            <Border x:Name="Capa"
                    Background="#0B1F33"
                    CornerRadius="8"
                    Opacity="0"/>
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Capa" Property="Opacity" Value="0.09"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Capa" Property="Opacity" Value="0.18"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Mx.ButtonBase" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="MinWidth" Value="110"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Mx.FocusRing}"/>
        <Setter Property="Template" Value="{StaticResource Mx.ButtonTemplate}"/>
    </Style>

    <Style x:Key="Mx.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Mx.ButtonBase}">
        <Setter Property="Background" Value="#1F4E79"/>
        <Setter Property="BorderBrush" Value="#1F4E79"/>
    </Style>

    <Style x:Key="Mx.SecondaryButton" TargetType="Button" BasedOn="{StaticResource Mx.ButtonBase}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#1F4E79"/>
        <Setter Property="BorderBrush" Value="#C9D3DF"/>
    </Style>

    <Style x:Key="Mx.DangerButton" TargetType="Button" BasedOn="{StaticResource Mx.ButtonBase}">
        <Setter Property="Background" Value="#B42318"/>
        <Setter Property="BorderBrush" Value="#B42318"/>
        <Setter Property="MinWidth" Value="160"/>
    </Style>

    <!-- Botón sin estilo explícito: mismo aspecto, tamaño según el contenido. -->
    <Style TargetType="Button" BasedOn="{StaticResource Mx.PrimaryButton}">
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Margin" Value="5"/>
    </Style>

    <!-- ==================== MENÚ LATERAL ==================== -->

    <Style x:Key="Mx.NavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Mx.FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1E4467"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#24507A"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#7F98AF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Opción del menú: la activa lleva una barra amarilla y fondo más claro. -->
    <Style x:Key="Mx.NavRadio" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Mx.FocusRingNav}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#B9CCDD"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Fondo"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Margin="8,0"/>
                        <Border x:Name="Indicador"
                                Width="4"
                                Height="20"
                                HorizontalAlignment="Left"
                                Background="#F2B705"
                                CornerRadius="0,2,2,0"
                                Visibility="Hidden"/>
                        <ContentPresenter ContentSource="Content"
                                          Margin="20,0,10,0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="#1D4466"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="#24527C"/>
                            <Setter TargetName="Indicador" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#6F88A0"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Mx.NavGroup" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#7F9BB5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="20,18,10,6"/>
    </Style>

    <!-- Enlace pequeño del menú lateral (cuenta del usuario) -->
    <Style x:Key="Mx.NavLink" TargetType="Button">
        <Setter Property="Foreground" Value="#B9CCDD"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="0,3"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Mx.FocusRingNav}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                            <Setter TargetName="Txt" Property="TextDecorations" Value="Underline"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== TARJETAS Y TEXTOS ==================== -->

    <Style x:Key="Mx.Card" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E1E7EF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <Style x:Key="Mx.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#12304D"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style x:Key="Mx.FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#4A5E73"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- ==================== CAMPOS DE TEXTO ==================== -->

    <Style x:Key="Mx.TextBox" TargetType="TextBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#1E2A38"/>
        <Setter Property="BorderBrush" Value="#C9D3DF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="10,2"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SelectionBrush" Value="#1F4E79"/>
        <Setter Property="CaretBrush" Value="#12304D"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                        </Border>
                        <!-- Texto de ayuda: se escribe en Tag y desaparece al escribir. -->
                        <TextBlock x:Name="Ayuda"
                                   Text="{TemplateBinding Tag}"
                                   Foreground="#8696A7"
                                   Margin="{TemplateBinding Padding}"
                                   Padding="3,0,0,0"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   IsHitTestVisible="False"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed"/>
                        <!-- Anillo de foco: no desplaza el texto. -->
                        <Border x:Name="Anillo"
                                BorderBrush="#1F4E79"
                                BorderThickness="2"
                                CornerRadius="8"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#8FA6BD"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Anillo" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Ayuda" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F6F8FB"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#F1F4F8"/>
                            <Setter Property="Foreground" Value="#8696A7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Cajas de varias líneas (observaciones): texto arriba. -->
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="Padding" Value="10,7"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource Mx.TextBox}"/>

    <!-- ==================== LISTAS DESPLEGABLES ==================== -->

    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Foreground" Value="#1E2A38"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#EEF3F9"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DFEAF6"/>
                            <Setter Property="Foreground" Value="#12304D"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#9AA8B6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#1E2A38"/>
        <Setter Property="BorderBrush" Value="#C9D3DF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="10,2,32,2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <ToggleButton x:Name="Alternar"
                                      Focusable="False"
                                      ClickMode="Press"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8">
                                        <Path x:Name="Flecha"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,1,13,0"
                                              Data="M0,0 L4.5,4.5 L9,0"
                                              Stroke="#5A6B7D"
                                              StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#8FA6BD"/>
                                            <Setter TargetName="Flecha" Property="Stroke" Value="#1F4E79"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Flecha" Property="Data" Value="M0,4.5 L4.5,0 L9,4.5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Border x:Name="Anillo"
                                BorderBrush="#1F4E79"
                                BorderThickness="2"
                                CornerRadius="8"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"/>

                        <ContentPresenter x:Name="Seleccion"
                                          IsHitTestVisible="False"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>

                        <TextBox x:Name="PART_EditableTextBox"
                                 Visibility="Hidden"
                                 Margin="{TemplateBinding Padding}"
                                 Padding="0"
                                 MinHeight="0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{TemplateBinding Foreground}"
                                 VerticalAlignment="Center"
                                 IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Focusable="False"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden"/>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border x:Name="Lista"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,4,8,10"
                                    Padding="4"
                                    Background="White"
                                    BorderBrush="#C9D3DF"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270"
                                                      Opacity="0.14" Color="#0B1F33"/>
                                </Border.Effect>
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Seleccion" Property="Visibility" Value="Hidden"/>
                            <Setter Property="IsTabStop" Value="False"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Anillo" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Anillo" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Lista" Property="MinHeight" Value="40"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== FECHAS ==================== -->

    <!-- El calendario y el selector de fecha usan su aspecto original
         en los botones internos (flechas, ícono de calendario). -->
    <Style TargetType="DatePicker">
        <Style.Resources>
            <Style TargetType="Button"/>
        </Style.Resources>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#C9D3DF"/>
        <Setter Property="Foreground" Value="#1E2A38"/>
        <Setter Property="Padding" Value="6,5"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="Calendar">
        <Style.Resources>
            <Style TargetType="Button"/>
        </Style.Resources>
    </Style>

    <!-- ==================== PESTAÑAS ==================== -->

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#E1E7EF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0,12,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                BorderBrush="#DCE3EC"
                                BorderThickness="0,0,0,1">
                            <TabPanel x:Name="HeaderPanel"
                                      IsItemsHost="True"
                                      Panel.ZIndex="1"
                                      KeyboardNavigation.TabIndex="1"
                                      Background="Transparent"
                                      Margin="0,0,0,-1"/>
                        </Border>
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0,0,10,10"
                                Padding="{TemplateBinding Padding}"
                                KeyboardNavigation.TabNavigation="Local"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                KeyboardNavigation.TabIndex="2">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pestaña subrayada: la activa en azul con línea inferior. -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="#5A6B7D"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Mx.FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid x:Name="Raiz" Background="Transparent" Margin="0,0,4,0">
                        <Border x:Name="Fondo"
                                CornerRadius="7,7,0,0"
                                Background="Transparent"/>
                        <ContentPresenter x:Name="Encabezado"
                                          ContentSource="Header"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="#5A6B7D"/>
                        <Border x:Name="Linea"
                                Height="3"
                                VerticalAlignment="Bottom"
                                CornerRadius="2,2,0,0"
                                Background="#1F4E79"
                                Margin="8,0"
                                Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="#EAF0F7"/>
                            <Setter TargetName="Encabezado" Property="TextElement.Foreground" Value="#12304D"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Linea" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Encabezado" Property="TextElement.Foreground" Value="#12304D"/>
                            <Setter Property="Panel.ZIndex" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Encabezado" Property="TextElement.Foreground" Value="#A3B1BF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== TABLAS ==================== -->

    <Style x:Key="Mx.ColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F6F8FB"/>
        <Setter Property="Foreground" Value="#4A5E73"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="BorderBrush" Value="#E1E7EF"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Mx.ColumnHeaderRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource Mx.ColumnHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <!-- Celda sin el recuadro azul de sistema al seleccionar. -->
    <Style x:Key="Mx.Cell" TargetType="DataGridCell">
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#12304D"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Mx.Row" TargetType="DataGridRow">
        <Setter Property="Background" Value="White"/>
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="#FAFBFD"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#EEF3F9"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#DFEAF6"/>
                <Setter Property="Foreground" Value="#12304D"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Mx.DataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#1E2A38"/>
        <Setter Property="BorderBrush" Value="#E1E7EF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#EEF2F6"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="RowHeight" Value="40"/>
        <Setter Property="ColumnHeaderHeight" Value="40"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource Mx.ColumnHeader}"/>
        <Setter Property="CellStyle" Value="{StaticResource Mx.Cell}"/>
        <Setter Property="RowStyle" Value="{StaticResource Mx.Row}"/>
    </Style>

    <Style TargetType="DataGrid" BasedOn="{StaticResource Mx.DataGrid}"/>

    <!-- ==================== BARRAS DE DESPLAZAMIENTO ==================== -->

    <Style x:Key="Mx.ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Barra" Background="#BFCBD8" CornerRadius="4"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Barra" Property="Background" Value="#93A6B9"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Barra" Property="Background" Value="#6F8499"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Mx.ScrollPage" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Mx.ScrollPage}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Mx.ScrollThumb}" Margin="2,2" MinHeight="28"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Mx.ScrollPage}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Mx.ScrollPage}" Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Mx.ScrollThumb}" Margin="2,2" MinWidth="28"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Mx.ScrollPage}" Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==================== CASILLAS Y OPCIONES ==================== -->

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#1E2A38"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Mx.FocusRing}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Caja"
                                Width="18" Height="18"
                                CornerRadius="4"
                                Background="White"
                                BorderBrush="#9FB0C2"
                                BorderThickness="1.5"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Grid>
                                <Path x:Name="Marca"
                                      Data="M3.5,8.5 L7,12 L13.5,4.5"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Margin="-0.5,-0.5,0,0"
                                      Visibility="Collapsed"/>
                                <Border x:Name="Medio"
                                        Width="8" Height="2"
                                        Background="White"
                                        CornerRadius="1"
                                        Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Caja" Property="BorderBrush" Value="#1F4E79"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Caja" Property="Background" Value="#1F4E79"/>
                            <Setter TargetName="Caja" Property="BorderBrush" Value="#1F4E79"/>
                            <Setter TargetName="Marca" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Caja" Property="Background" Value="#1F4E79"/>
                            <Setter TargetName="Caja" Property="BorderBrush" Value="#1F4E79"/>
                            <Setter TargetName="Medio" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="#1E2A38"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Mx.FocusRing}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="18" Height="18" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Ellipse x:Name="Aro" Fill="White" Stroke="#9FB0C2" StrokeThickness="1.5"/>
                            <Ellipse x:Name="Punto" Width="8" Height="8" Fill="#1F4E79" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Aro" Property="Stroke" Value="#1F4E79"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Aro" Property="Stroke" Value="#1F4E79"/>
                            <Setter TargetName="Punto" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== MENSAJES EMERGENTES ==================== -->

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#12304D"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            MaxWidth="360">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
