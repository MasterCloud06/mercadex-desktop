
<UserControl x:Class="Mercadex.Desktop.App.Views.AnularCobroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="16">

            <TextBlock Text="Anular cobro"
                       FontSize="27"
                       FontWeight="Bold"
                       Foreground="#173B5C"/>

            <TextBlock
                Text="Localizar y revisar un recibo antes de su anulaci&#243;n."
                Foreground="#60748A"
                TextWrapping="Wrap"
                Margin="0,5,0,16"/>

            <!-- BUSQUEDA -->

            <Border Background="White"
                    BorderBrush="#DFE6EE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,14">

                <StackPanel>

                    <TextBlock Text="Buscar recibo"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#173B5C"
                               Margin="0,0,0,14"/>

                    <WrapPanel>

                        <StackPanel Width="175"
                                    Margin="0,0,14,12">

                            <TextBlock Text="N&#250;mero de recibo"
                                       Margin="0,0,0,5"/>

                            <TextBox x:Name="TxtNumero"
                                     Height="36"
                                     VerticalContentAlignment="Center"
                                     KeyDown="TxtNumero_KeyDown"/>

                        </StackPanel>

                        <StackPanel Width="175"
                                    Margin="0,0,14,12">

                            <TextBlock Text="Fecha (opcional)"
                                       Margin="0,0,0,5"/>

                            <DatePicker x:Name="FechaFiltro"
                                        Height="36"/>

                        </StackPanel>

                        <Button Content="BUSCAR"
                                Click="Buscar_Click"
                                Height="38"
                                MinWidth="115"
                                Margin="0,20,12,12"
                                Padding="15,0"
                                Background="#1F4E79"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"/>

                        <Button Content="ACTUALIZAR"
                                Click="Actualizar_Click"
                                Height="38"
                                MinWidth="125"
                                Margin="0,20,0,12"
                                Padding="15,0"/>

                    </WrapPanel>

                    <TextBlock x:Name="TxtEstado"
                               Text="Preparando consulta..."
                               Foreground="#1F4E79"
                               TextWrapping="Wrap"/>

                </StackPanel>

            </Border>

            <!-- RESULTADOS -->

            <Border Background="White"
                    BorderBrush="#DFE6EE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,14">

                <StackPanel>

                    <TextBlock Text="Recibos encontrados"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#173B5C"
                               Margin="0,0,0,12"/>

                    <DataGrid x:Name="TablaRecibos"
                              Height="230"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionChanged="TablaRecibos_SelectionChanged"
                              AlternatingRowBackground="#F1F5FA"
                              HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="Recibo"
                                Binding="{Binding Numero}"
                                Width="90"/>

                            <DataGridTextColumn
                                Header="Fecha"
                                Binding="{Binding FechaEmision,
                                    StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                Width="160"/>

                            <DataGridTextColumn
                                Header="Importe"
                                Binding="{Binding Total,
                                    StringFormat=N2}"
                                Width="130"/>

                            <DataGridTextColumn
                                Header="Estado"
                                Binding="{Binding Estado}"
                                Width="*"
                                MinWidth="120"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </StackPanel>

            </Border>

            <!-- RECIBO SELECCIONADO -->

            <Border Background="White"
                    BorderBrush="#DFE6EE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">

                <StackPanel>

                    <TextBlock Text="Comprobante seleccionado"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#173B5C"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="TxtEstadoRecibo"
                               Text="SIN SELECCIONAR"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#173B5C"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="TxtDetalle"
                               Text="Selecciona un recibo para consultar sus datos."
                               TextWrapping="Wrap"
                               LineHeight="24"
                               Margin="0,0,0,16"/>

                    <Separator Margin="0,0,0,15"/>

                    <TextBlock Text="Motivo de anulaci&#243;n"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="TxtMotivo"
                             Height="80"
                             MaxLength="500"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             IsEnabled="False"
                             Margin="0,0,0,12"/>

                    <TextBlock
                        Text="Requiere usuario y contrase&#241;a de administrador. El recibo queda registrado como ANULADO, las deudas vuelven a estar pendientes y se genera un comprobante de anulaci&#243;n."
                        TextWrapping="Wrap"
                        Foreground="#A52A2A"
                        Margin="0,0,0,12"/>

                    <Button x:Name="BtnAnular"
                            Content="ANULAR COBRO"
                            IsEnabled="False"
                            Click="Anular_Click"
                            Height="42"
                            MinWidth="185"
                            HorizontalAlignment="Right"
                            Padding="20,0"
                            Background="#A52A2A"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
