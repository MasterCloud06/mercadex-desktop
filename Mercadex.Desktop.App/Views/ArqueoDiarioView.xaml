<UserControl x:Class="Mercadex.Desktop.App.Views.ArqueoDiarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FA"
             FontFamily="{StaticResource Mx.Font}">

    <UserControl.Resources>
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DFE6EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="Titulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#173B5C"/>
        </Style>
        <Style x:Key="Ayuda" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#7A8A9C"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5E73"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="TileValor" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#173B5C"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="16">

            <TextBlock Text="Arqueo y cierre de caja" FontSize="25" FontWeight="Bold" Foreground="#173B5C"/>
            <TextBlock Text="Recaudación del día por forma de pago, verificación del efectivo y registro del cierre"
                       Foreground="#60748A" Margin="0,5,0,16"/>

            <!-- FECHA Y ESTADO -->
            <Border Style="{StaticResource Tarjeta}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="Fecha" Style="{StaticResource Etiqueta}"/>
                            <DatePicker x:Name="FechaArqueo" Width="170" Height="36" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="BtnConsultar" Content="Consultar" Click="Consultar_Click"
                                Style="{StaticResource Mx.PrimaryButton}" Width="140" Height="36"
                                VerticalAlignment="Bottom" Margin="12,0,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtEstado" Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Bottom"
                               Text="Selecciona una fecha y presiona Consultar." Foreground="#355D7E" TextWrapping="Wrap"/>

                    <Border x:Name="ChipEstado" Grid.Column="2" CornerRadius="14" Padding="14,6" VerticalAlignment="Center"
                            Background="#EEF2F7">
                        <TextBlock x:Name="TxtChipEstado" Text="Sin consultar" FontWeight="SemiBold" Foreground="#5A6B7D"/>
                    </Border>
                </Grid>
            </Border>

            <!-- RECAUDACIÓN DEL DÍA -->
            <Border Style="{StaticResource Tarjeta}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Recaudación del día" Style="{StaticResource Titulo}"/>
                            <TextBlock Text="Solo cobros válidos (sin anulados). Cada moneda se arquea por separado."
                                       Style="{StaticResource Ayuda}" Margin="0,3,0,12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Moneda" Style="{StaticResource Etiqueta}"/>
                            <ComboBox x:Name="SelectorMoneda" Width="160" Height="34" DisplayMemberPath="Moneda"
                                      SelectionChanged="Moneda_Changed"/>
                        </StackPanel>
                    </Grid>

                    <UniformGrid Columns="4" Margin="0,4,0,0">
                        <Border Background="#F3F6FA" CornerRadius="8" Padding="14,10" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Efectivo" Style="{StaticResource Etiqueta}" Margin="0"/>
                                <TextBlock x:Name="TileEfectivo" Text="—" Style="{StaticResource TileValor}"/>
                                <TextBlock x:Name="TileEfectivoN" Text=" " Style="{StaticResource Ayuda}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F3F6FA" CornerRadius="8" Padding="14,10" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="QR" Style="{StaticResource Etiqueta}" Margin="0"/>
                                <TextBlock x:Name="TileQr" Text="—" Style="{StaticResource TileValor}"/>
                                <TextBlock x:Name="TileQrN" Text=" " Style="{StaticResource Ayuda}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F3F6FA" CornerRadius="8" Padding="14,10" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Otros" Style="{StaticResource Etiqueta}" Margin="0"/>
                                <TextBlock x:Name="TileOtros" Text="—" Style="{StaticResource TileValor}"/>
                                <TextBlock x:Name="TileOtrosN" Text=" " Style="{StaticResource Ayuda}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1F4E79" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Total recaudado" FontSize="13" FontWeight="SemiBold" Foreground="#D6E4F2"/>
                                <TextBlock x:Name="TileTotal" Text="—" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                <TextBlock x:Name="TileTotalN" Text=" " FontSize="12" Foreground="#D6E4F2"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border x:Name="AvisoCambios" Visibility="Collapsed" Background="#FDECEC" CornerRadius="6"
                            Padding="12,8" Margin="0,12,0,0">
                        <TextBlock x:Name="TxtAvisoCambios" Foreground="#B42318" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- CIERRE -->
            <Border Style="{StaticResource Tarjeta}">
                <StackPanel>
                    <TextBlock Text="Verificación y cierre" Style="{StaticResource Titulo}"/>
                    <TextBlock x:Name="TxtAyudaCierre" Style="{StaticResource Ayuda}" Margin="0,3,0,14"
                               Text="Cuenta el efectivo de caja, escríbelo y registra el cierre. Un cierre registrado no se puede modificar."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="PanelEntradas" Width="300" Margin="0,0,24,0">
                            <TextBlock Text="Efectivo contado" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="TxtContado" Height="38" FontSize="16" Padding="8,0"
                                     VerticalContentAlignment="Center" TextChanged="Contado_Changed"
                                     Style="{StaticResource Mx.TextBox}"/>
                            <TextBlock Text="Sin separadores de miles. Ejemplo: 850,50" Style="{StaticResource Ayuda}" Margin="0,4,0,12"/>

                            <TextBlock Text="Responsable del cierre *" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="TxtResponsable" Height="36" MaxLength="120" Padding="8,0"
                                     VerticalContentAlignment="Center" Style="{StaticResource Mx.TextBox}" Margin="0,0,0,12"/>

                            <TextBlock Text="Observación" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="TxtObservacion" Height="70" MaxLength="500" Padding="8,6"
                                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource Mx.TextBox}"/>
                            <TextBlock Text="Obligatoria si hay diferencia de efectivo." Style="{StaticResource Ayuda}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <Border Background="#F3F6FA" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Diferencia de efectivo" Style="{StaticResource Etiqueta}"/>
                                    <TextBlock x:Name="TxtDiferencia" Text="Sin calcular" FontSize="26" FontWeight="Bold" Foreground="#173B5C"/>
                                    <TextBlock Text="Contado − efectivo registrado. Positivo = sobrante; negativo = faltante."
                                               Style="{StaticResource Ayuda}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="PanelCerrado" Visibility="Collapsed" Background="#E7F5E7" CornerRadius="8"
                                    Padding="16,12" Margin="0,0,0,12">
                                <TextBlock x:Name="TxtCerrado" Foreground="#0B5A0B" TextWrapping="Wrap"/>
                            </Border>

                            <WrapPanel>
                                <Button x:Name="BtnCerrar" Content="Registrar cierre del día" Click="Cerrar_Click"
                                        Height="42" Padding="18,0" Margin="0,0,10,10"
                                        Background="#287A42" BorderBrush="#287A42" Foreground="White" FontWeight="Bold"
                                        Style="{StaticResource Mx.PrimaryButton}"/>
                                <Button x:Name="BtnActa" Content="VISTA PREVIA / IMPRIMIR / PDF" Click="Acta_Click"
                                        Height="42" Padding="18,0" Margin="0,0,10,10"
                                        Style="{StaticResource Mx.SecondaryButton}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- HISTORIAL -->
            <Border Style="{StaticResource Tarjeta}">
                <StackPanel>
                    <TextBlock Text="Historial de cierres" Style="{StaticResource Titulo}"/>
                    <TextBlock Text="Para conciliar con el libro mayor y el extracto bancario." Style="{StaticResource Ayuda}" Margin="0,3,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Desde" Style="{StaticResource Etiqueta}"/>
                            <DatePicker x:Name="HistDesde" Width="150" Height="34"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Hasta" Style="{StaticResource Etiqueta}"/>
                            <DatePicker x:Name="HistHasta" Width="150" Height="34"/>
                        </StackPanel>
                        <Button Content="Consultar" Click="Historial_Click" Width="130" Height="34" VerticalAlignment="Bottom"
                                Style="{StaticResource Mx.PrimaryButton}" Margin="0,0,10,0"/>
                        <Button x:Name="BtnActaHistorial" Content="Imprimir cierre seleccionado" Click="ActaHistorial_Click"
                                Height="34" Padding="14,0" VerticalAlignment="Bottom" IsEnabled="False"
                                Style="{StaticResource Mx.SecondaryButton}"/>
                    </StackPanel>

                    <DataGrid x:Name="TablaHistorial" Style="{StaticResource Mx.DataGrid}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" MinHeight="120" MaxHeight="320"
                              SelectionChanged="Historial_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="100"/>
                            <DataGridTextColumn Header="Moneda" Binding="{Binding Moneda}" Width="70"/>
                            <DataGridTextColumn Header="Efectivo" Binding="{Binding Efectivo, StringFormat=N2}" Width="105"/>
                            <DataGridTextColumn Header="QR" Binding="{Binding Qr, StringFormat=N2}" Width="105"/>
                            <DataGridTextColumn Header="Otros" Binding="{Binding Otros, StringFormat=N2}" Width="95"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="110"/>
                            <DataGridTextColumn Header="Contado" Binding="{Binding EfectivoContado, StringFormat=N2}" Width="105"/>
                            <DataGridTextColumn Header="Diferencia" Binding="{Binding Diferencia, StringFormat=N2}" Width="95"/>
                            <DataGridTextColumn Header="Responsable" Binding="{Binding Responsable}" Width="*" MinWidth="140"/>
                            <DataGridTextColumn Header="Registrado" Binding="{Binding RegistradoTexto}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
