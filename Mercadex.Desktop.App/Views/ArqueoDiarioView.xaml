<UserControl x:Class="Mercadex.Desktop.App.Views.ArqueoDiarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="16">

            <TextBlock Text="Arqueo diario de recaudaciones"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#173B5C"/>

            <TextBlock Text="Consulta de efectivo, QR y otros medios de pago"
                       Foreground="#60748A"
                       Margin="0,5,0,16"/>

            <Border Background="#FFF4DA"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,0,0,15">

                <TextBlock
                    Text="CONSULTA PRELIMINAR: todavía no registra un cierre de caja ni bloquea movimientos."
                    Foreground="#805600"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"/>

            </Border>

            <!-- FILTROS -->

            <Border Background="White"
                    BorderBrush="#DFE6EE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,15">

                <StackPanel>

                    <TextBlock Text="Fecha del arqueo"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal">

                        <DatePicker x:Name="FechaArqueo"
                                    Width="170"
                                    Height="35"
                                    VerticalContentAlignment="Center"/>

                        <Button x:Name="BtnConsultar"
                                Content="CONSULTAR RECAUDACIÓN"
                                Click="Consultar_Click"
                                Background="#1769AA"
                                Foreground="White"
                                FontWeight="Bold"
                                Padding="18,8"
                                Margin="12,0,0,0"
                                MinHeight="35"/>

                    </StackPanel>

                </StackPanel>

            </Border>

            <!-- RESUMEN -->

            <Border Background="White"
                    BorderBrush="#DFE6EE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,15">

                <StackPanel>

                    <TextBlock Text="Recaudación registrada"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#173B5C"
                               Margin="0,0,0,10"/>

                    <TextBlock
                        Text="Los importes se muestran separados por moneda. No se suman bolivianos con otras divisas."
                        Foreground="#60748A"
                        TextWrapping="Wrap"
                        Margin="0,0,0,12"/>

                    <DataGrid x:Name="TablaResumen"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              Height="205"
                              HeadersVisibility="Column"
                              AlternatingRowBackground="#F2F6FA">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Moneda"
                                                Binding="{Binding Moneda}"
                                                Width="85"/>

                            <DataGridTextColumn Header="Efectivo"
                                                Binding="{Binding Efectivo, StringFormat=N2}"
                                                Width="115"/>

                            <DataGridTextColumn Header="QR"
                                                Binding="{Binding Qr, StringFormat=N2}"
                                                Width="115"/>

                            <DataGridTextColumn Header="Otros"
                                                Binding="{Binding Otros, StringFormat=N2}"
                                                Width="115"/>

                            <DataGridTextColumn Header="Total"
                                                Binding="{Binding Total, StringFormat=N2}"
                                                Width="115"/>

                            <DataGridTextColumn Header="Pagos"
                                                Binding="{Binding Cantidad}"
                                                Width="75"/>

                        </DataGrid.Columns>

                    </DataGrid>

                    <TextBlock x:Name="TxtEstado"
                               Text="Selecciona una fecha y presiona Consultar."
                               TextWrapping="Wrap"
                               Foreground="#355D7E"
                               Margin="0,12,0,0"/>

                </StackPanel>

            </Border>

            <!-- VERIFICACION -->

            <Border Background="White"
                    BorderBrush="#DFE6EE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,15">

                <StackPanel>

                    <TextBlock Text="Verificación del efectivo físico"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#173B5C"
                               Margin="0,0,0,14"/>

                    <TextBlock
                        Text="Selecciona una moneda para comparar el efectivo registrado con el dinero contado."
                        TextWrapping="Wrap"
                        Foreground="#60748A"
                        Margin="0,0,0,12"/>

                    <TextBlock Text="Moneda"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>

                    <ComboBox x:Name="SelectorMoneda"
                              Width="200"
                              HorizontalAlignment="Left"
                              Height="34"
                              DisplayMemberPath="Moneda"
                              SelectionChanged="Moneda_Changed"
                              Margin="0,0,0,14"/>

                    <TextBlock Text="Efectivo contado"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="TxtContado"
                             Width="200"
                             Height="35"
                             HorizontalAlignment="Left"
                             VerticalContentAlignment="Center"
                             Padding="8,0"
                             FontSize="16"
                             TextChanged="Contado_Changed"
                             Margin="0,0,0,5"/>

                    <TextBlock
                        Text="Introduce el importe sin separadores de miles. Ejemplo: 850,50"
                        FontSize="12"
                        Foreground="#60748A"
                        Margin="0,0,0,15"/>

                    <TextBlock Text="Diferencia de efectivo"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBlock x:Name="TxtDiferencia"
                               Text="Sin calcular"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#173B5C"/>

                    <TextBlock
                        Text="Diferencia = efectivo contado - efectivo registrado. Los pagos QR deben conciliarse con el banco."
                        TextWrapping="Wrap"
                        Foreground="#60748A"
                        Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>