<UserControl x:Class="Mercadex.Desktop.App.Views.CajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FA"
             FontFamily="Segoe UI"
             FontSize="14"
             Language="es-BO"
             TextOptions.TextFormattingMode="Display">

    <Grid Margin="20,16,20,18">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->

        <Grid Grid.Row="0" Margin="0,0,0,14">

            <StackPanel>

                <TextBlock Text="Caja"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="#173B5C"/>

                <TextBlock
                    Text="Consulta y control de recibos emitidos"
                    Foreground="#60748A"
                    Margin="0,4,0,0"/>

            </StackPanel>

        </Grid>

        <!-- INFORMACION -->

        <Border Grid.Row="1"
                Background="#E7F0F9"
                BorderBrush="#D7E6F4"
                BorderThickness="1"
                CornerRadius="9"
                Padding="14,11"
                Margin="0,0,0,14">

            <TextBlock
                Text="Los cobros nuevos se registran en Ingresos. Aquí puedes consultar los recibos emitidos sin generar nuevos cobros."
                Foreground="#1F4E79"
                TextWrapping="Wrap"
                FontSize="13"/>

        </Border>

        <!-- TARJETA DE RECIBOS -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DFE6EE"
                BorderThickness="1"
                CornerRadius="11"
                Padding="16,14"
                Margin="0,0,0,14"
                MinHeight="240">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TITULO -->

                <TextBlock Grid.Row="0"
                           Text="Recibos registrados"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#173B5C"
                           Margin="0,0,0,12"/>

                <!-- BUSQUEDA -->

                <Grid Grid.Row="1"
                      Margin="0,0,0,14">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                HorizontalAlignment="Left">

                        <TextBlock
                            Text="Buscar por número de recibo"
                            Style="{StaticResource Mx.FieldLabel}"/>

                        <TextBox x:Name="TxtBuscarRecibo"
                                 Width="250"
                                 Height="38"
                                 Style="{StaticResource Mx.TextBox}"
                                 ToolTip="Buscar por número de recibo"
                                 TextChanged="BuscarRecibo_TextChanged"/>

                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Actualizar"
                            Click="Actualizar_Click"
                            Style="{StaticResource Mx.PrimaryButton}"
                            Height="38"
                            MinWidth="118"
                            VerticalAlignment="Bottom"/>

                </Grid>

                <!-- TABLA -->

                <DataGrid x:Name="TablaRecibos"
                          Grid.Row="2"
                          Style="{StaticResource Mx.DataGrid}"
                          MinHeight="155"
                          MaxHeight="245"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionChanged="TablaRecibos_SelectionChanged"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">

                    <DataGrid.Columns>

                        <DataGridTextColumn
                            Header="Recibo"
                            Binding="{Binding Numero}"
                            Width="90"/>

                        <DataGridTextColumn
                            Header="Fecha"
                            Binding="{Binding Fecha}"
                            Width="165"/>

                        <DataGridTextColumn
                            Header="Importe (Bs)"
                            Binding="{Binding Total, StringFormat=N2}"
                            Width="135"/>

                        <!-- ESTADO CON COLOR -->

                        <DataGridTemplateColumn
                            Header="Estado"
                            Width="125">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <Border HorizontalAlignment="Left"
                                            CornerRadius="9"
                                            Padding="9,3">

                                        <Border.Style>

                                            <Style TargetType="Border">

                                                <Setter Property="Background"
                                                        Value="#E7EFF8"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Estado}"
                                                                 Value="Emitido">
                                                        <Setter Property="Background"
                                                                Value="#DFF3E6"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Estado}"
                                                                 Value="Anulado">
                                                        <Setter Property="Background"
                                                                Value="#F9E0E0"/>
                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </Border.Style>

                                        <TextBlock Text="{Binding Estado}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#173B5C"/>

                                    </Border>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                        <DataGridTextColumn
                            Header="ID unidad comercial"
                            Binding="{Binding UnidadComercialId}"
                            Width="*"
                            MinWidth="170"/>

                    </DataGrid.Columns>

                </DataGrid>

                <!-- ESTADO DE CONSULTA -->

                <TextBlock x:Name="TxtEstado"
                           Grid.Row="3"
                           Text="Preparado para consultar los recibos."
                           FontSize="12"
                           Foreground="#60748A"
                           TextWrapping="Wrap"
                           Margin="1,12,0,0"/>

            </Grid>

        </Border>

        <!-- DETALLE DEL RECIBO -->

        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#DFE6EE"
                BorderThickness="1"
                CornerRadius="11"
                Padding="16,14">

            <StackPanel>

                <TextBlock Text="Detalle del recibo"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="#173B5C"
                           Margin="0,0,0,10"/>

                <Border Background="#F7F9FC"
                        CornerRadius="7"
                        Padding="12,10">

                    <TextBlock x:Name="TxtDetalle"
                               Text="Selecciona un recibo para consultar su información."
                               TextWrapping="Wrap"
                               Foreground="#31465A"
                               FontSize="13"
                               LineHeight="21"/>

                </Border>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>