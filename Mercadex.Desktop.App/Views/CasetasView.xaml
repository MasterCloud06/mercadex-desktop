<UserControl x:Class="Mercadex.Desktop.App.Views.CasetasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FA" FontFamily="{StaticResource Mx.Font}" FontSize="14" Language="es-BO">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="18,16,18,20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->

            <Grid Grid.Row="0"
                  Margin="0,0,0,18">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Casetas y Unidades Comerciales"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="#173B5C"/>

                    <TextBlock Text="Administración de pasillos, casetas, comedores y ambulantes"
                               FontSize="14"
                               Foreground="#60748A"
                               Margin="0,4,0,0"/>

                </StackPanel>

                <Button Style="{StaticResource Mx.PrimaryButton}" Grid.Column="1"
                        Content="Actualizar"
                        Width="120"
                        Height="38"
                        Command="{Binding CargarCommand}"/>

            </Grid>

            <!-- REGISTRO DE PASILLO -->

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#DFE6EE"
                    BorderThickness="1"
                    CornerRadius="11"
                    Padding="16,14"
                    Margin="0,0,0,12">

                <StackPanel>

                    <TextBlock Text="Registrar pasillo"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#173B5C"
                               Margin="0,0,0,15"/>

                    <WrapPanel>

                        <StackPanel Margin="0,0,16,10">

                            <TextBlock Text="Código *"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <TextBox Style="{StaticResource Mx.TextBox}" Width="140"
                                     Height="36"

                                     Text="{Binding CodigoPasillo,
                                         UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>

                        <StackPanel Margin="0,0,16,10">

                            <TextBlock Text="Nombre del pasillo *"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <TextBox Style="{StaticResource Mx.TextBox}" Width="300"
                                     Height="36"

                                     Text="{Binding NombrePasillo,
                                         UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>

                    </WrapPanel>

                    <Button Style="{StaticResource Mx.PrimaryButton}" Content="Registrar pasillo"
                            Width="170"
                            Height="40"
                            HorizontalAlignment="Left"
                            Command="{Binding GuardarPasilloCommand}"
                            Background="#1F4E79"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"/>

                </StackPanel>

            </Border>

            <!-- REGISTRO DE UNIDAD -->

            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#DFE6EE"
                    BorderThickness="1"
                    CornerRadius="11"
                    Padding="16,14"
                    Margin="0,0,0,12">

                <StackPanel>

                    <TextBlock Text="Registrar nueva unidad comercial"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#173B5C"
                               Margin="0,0,0,15"/>

                    <WrapPanel>

                        <StackPanel Margin="0,0,16,10">

                            <TextBlock Text="Código / Número *"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <TextBox Style="{StaticResource Mx.TextBox}" Width="140"
                                     Height="36"

                                     Text="{Binding CodigoUnidad,
                                         UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>

                        <StackPanel Margin="0,0,16,10">

                            <TextBlock Text="Tipo *"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <ComboBox FontSize="14" BorderBrush="#C5D1DE" Background="White" Width="160"
                                      Height="36"
                                      ItemsSource="{Binding Tipos}"
                                      SelectedItem="{Binding TipoSeleccionado}"
                                      DisplayMemberPath="Nombre"/>

                        </StackPanel>

                        <StackPanel Margin="0,0,16,10">

                            <TextBlock Text="Pasillo"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <ComboBox FontSize="14" BorderBrush="#C5D1DE" Background="White" Width="250"
                                      Height="36"
                                      ItemsSource="{Binding Pasillos}"
                                      SelectedItem="{Binding PasilloSeleccionado}"
                                      DisplayMemberPath="Descripcion"/>

                        </StackPanel>

                        <StackPanel Margin="0,0,16,10">

                            <TextBlock Text="Bloque"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <TextBox Style="{StaticResource Mx.TextBox}" Width="140"
                                     Height="36"

                                     Text="{Binding Bloque,
                                         UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>

                    </WrapPanel>

                    <StackPanel Orientation="Horizontal">

                        <Button Style="{StaticResource Mx.PrimaryButton}" Content="Registrar unidad"
                                Width="170"
                                Height="40"
                                Margin="0,0,10,0"
                                Command="{Binding GuardarUnidadCommand}"
                                Background="#1F4E79"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"/>

                        <Button Style="{StaticResource Mx.SecondaryButton}" Content="Limpiar"
                                Width="100"
                                Height="40"
                                Command="{Binding LimpiarUnidadCommand}"/>

                    </StackPanel>

                </StackPanel>

            </Border>

            <!-- EDITAR UBICACIÓN -->

            <Border Grid.Row="3"
                    Background="White"
                    BorderBrush="#D6B15A"
                    BorderThickness="1"
                    CornerRadius="11"
                    Padding="16,14"
                    Margin="0,0,0,12">

                <StackPanel>

                    <TextBlock Text="Ubicación y titular de la unidad"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#8A5A00"/>

                    <TextBlock Text="Selecciona primero una unidad en la tabla inferior."
                               Foreground="#6D6251"
                               Margin="0,4,0,15"/>

                    <WrapPanel>

                        <StackPanel Margin="0,0,16,10">

                            <TextBlock Text="Unidad seleccionada"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <TextBox Style="{StaticResource Mx.TextBox}" Width="150"
                                     Height="36"

                                     IsReadOnly="True"
                                     Text="{Binding UnidadSeleccionada.Codigo}"/>

                        </StackPanel>

                        <StackPanel Margin="0,0,16,10">

                            <TextBlock Text="Tipo"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <TextBox Style="{StaticResource Mx.TextBox}" Width="140"
                                     Height="36"

                                     IsReadOnly="True"
                                     Text="{Binding UnidadSeleccionada.TipoNombre}"/>

                        </StackPanel>

                        <StackPanel Margin="0,0,16,10">

                            <TextBlock Text="Pasillo *"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <ComboBox FontSize="14" BorderBrush="#C5D1DE" Background="White" Width="260"
                                      Height="36"
                                      ItemsSource="{Binding Pasillos}"
                                      SelectedItem="{Binding PasilloEdicionSeleccionado}"
                                      DisplayMemberPath="Descripcion"/>

                        </StackPanel>

                        <StackPanel Margin="0,0,16,10">

                            <TextBlock Text="Bloque"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <TextBox Style="{StaticResource Mx.TextBox}" Width="140"
                                     Height="36"

                                     Text="{Binding BloqueEdicion,
                                         UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>

                    </WrapPanel>

                    <!-- TITULAR -->

                    <WrapPanel Margin="0,4,0,0">

                        <StackPanel Margin="0,0,16,10">

                            <TextBlock Text="Titular actual"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <TextBox Style="{StaticResource Mx.TextBox}" Width="300"
                                     Height="36"
                                     IsReadOnly="True"
                                     Text="{Binding TitularActual}"/>

                        </StackPanel>

                        <StackPanel Margin="0,0,16,10">

                            <TextBlock Text="Nuevo titular (socio)"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <ComboBox FontSize="14" BorderBrush="#C5D1DE" Background="White" Width="340"
                                      Height="36"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="NombreCompleto"
                                      ItemsSource="{Binding Socios}"
                                      SelectedItem="{Binding SocioTitularSeleccionado}"
                                      DisplayMemberPath="Descripcion"
                                      ToolTip="Escribe el nombre para buscar. Los socios se registran en el menú Socios."/>

                        </StackPanel>

                        <StackPanel Margin="0,0,16,10" VerticalAlignment="Bottom">

                            <Button Style="{StaticResource Mx.PrimaryButton}" Content="Asignar titular"
                                    Width="170"
                                    Height="36"
                                    Command="{Binding AsignarTitularCommand}"/>

                        </StackPanel>

                    </WrapPanel>

                    <StackPanel Orientation="Horizontal">

                        <Button Style="{StaticResource Mx.PrimaryButton}" Content="Guardar ubicación"
                                Width="185"
                                Height="40"
                                Margin="0,0,10,0"
                                Command="{Binding GuardarUbicacionCommand}"
                                Background="#A66A00"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"/>

                        <Button Style="{StaticResource Mx.SecondaryButton}" Content="Limpiar selección"
                                Width="140"
                                Height="40"
                                Command="{Binding LimpiarUbicacionCommand}"/>

                    </StackPanel>

                </StackPanel>

            </Border>

            <!-- TABLA -->

            <DataGrid Grid.Row="4"
                      Style="{StaticResource Mx.DataGrid}"
                      MaxHeight="440"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      ItemsSource="{Binding Unidades}"
                      SelectedItem="{Binding UnidadSeleccionada}"
                      SelectionMode="Single"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      MinHeight="270"
                      RowHeight="36"
                      Background="White"
                      BorderBrush="#DFE6EE"
                      BorderThickness="1"
                      AlternatingRowBackground="#F3F6FA"
                      GridLinesVisibility="Horizontal">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Código"
                                        Binding="{Binding Codigo}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Tipo"
                                        Binding="{Binding TipoNombre}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Pasillo"
                                        Binding="{Binding PasilloNombre}"
                                        Width="*"
                                        MinWidth="180"/>

                    <DataGridTextColumn Header="Bloque"
                                        Binding="{Binding Bloque}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Titular"
                                        Binding="{Binding Titular}"
                                        Width="220"/>

                    <DataGridCheckBoxColumn Header="Activa"
                                            Binding="{Binding Activa}"
                                            Width="90"/>

                    <DataGridTextColumn Header="Fecha de registro"
                                        Binding="{Binding FechaRegistro,
                                            StringFormat=dd/MM/yyyy HH:mm}"
                                        Width="170"/>

                </DataGrid.Columns>

            </DataGrid>

            <!-- MENSAJE -->

            <Border Grid.Row="5"
                    Background="#E7F0F9"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,12,0,0">

                <TextBlock Text="{Binding Mensaje}"
                           Foreground="#1F4E79"
                           TextWrapping="Wrap"/>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>