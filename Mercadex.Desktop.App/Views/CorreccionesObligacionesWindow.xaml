<Window x:Class="Mercadex.Desktop.App.Views.CorreccionesObligacionesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mercadex - Modificar deudas"
        Width="1090"
        Height="800"
        MinWidth="880"
        MinHeight="660"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6FA"
        FontFamily="Segoe UI">

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="165"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Modificar deudas"
                       FontSize="27"
                       FontWeight="Bold"
                       Foreground="#173B5C"/>

            <TextBlock x:Name="TxtPeriodo"
                       Margin="0,4,0,0"
                       Foreground="#60748A"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#DFE6EE"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">

            <DockPanel LastChildFill="True">

                <Button x:Name="BtnActualizar"
                        DockPanel.Dock="Right"
                        Content="Actualizar deudas"
                        Width="160"
                        Height="35"
                        Margin="12,0,0,0"
                        Click="Actualizar_Click"
                        Style="{StaticResource Mx.SecondaryButton}"/>

                <TextBlock x:Name="TxtResumen"
                           VerticalAlignment="Center"
                           Foreground="#173B5C"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>

            </DockPanel>
        </Border>

        <DataGrid Grid.Row="2"
                  x:Name="TablaDeudas"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionChanged="Deudas_SelectionChanged"
                  RowHeight="34"
                  ColumnHeaderHeight="38"
                  AlternatingRowBackground="#F1F6FA"
                  BorderBrush="#DFE6EE">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Caseta"
                                    Binding="{Binding Caseta}"
                                    Width="125"/>

                <DataGridTextColumn Header="Bloque"
                                    Binding="{Binding Bloque}"
                                    Width="135"/>

                <DataGridTextColumn Header="Estado"
                                    Binding="{Binding Estado}"
                                    Width="160"/>

                <DataGridTextColumn Header="Monto deuda"
                                    Binding="{Binding Monto, StringFormat=N2}"
                                    Width="130"/>

                <DataGridTextColumn Header="Moneda"
                                    Binding="{Binding Moneda}"
                                    Width="95"/>

                <DataGridTextColumn Header="Historial"
                                    Binding="{Binding Distintivo}"
                                    Width="145"/>

                <DataGridTextColumn Header="Edición"
                                    Binding="{Binding PermisoVisual}"
                                    Width="*"/>

            </DataGrid.Columns>

        </DataGrid>

        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#DFE6EE"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,12,0,12">

            <StackPanel>

                <TextBlock Text="Corregir importe de la obligación seleccionada"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#173B5C"
                           Margin="0,0,0,8"/>

                <TextBlock x:Name="TxtSeleccion"
                           Foreground="#60748A"
                           Margin="0,0,0,10"
                           TextWrapping="Wrap"/>

                <WrapPanel>

                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="Nuevo importe"/>
                        <TextBox x:Name="TxtNuevoMonto"
                                 Width="140"
                                 Height="35"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="Motivo obligatorio"/>
                        <TextBox x:Name="TxtMotivo"
                                 Width="420"
                                 Height="65"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MaxLength="500"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <Button x:Name="BtnCorregir"
                            Content="Guardar modificación"
                            Width="190"
                            Height="36"
                            Margin="0,18,0,0"
                            IsEnabled="False"
                            Click="Corregir_Click"
                            Style="{StaticResource Mx.PrimaryButton}"/>

                </WrapPanel>

            </StackPanel>

        </Border>

        <Border Grid.Row="4"
                Background="White"
                BorderBrush="#DFE6EE"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">

            <DockPanel>

                <TextBlock DockPanel.Dock="Top"
                           Text="Historial de modificaciones"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#173B5C"
                           Margin="0,0,0,8"/>

                <DataGrid x:Name="TablaHistorial"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Anterior"
                                            Binding="{Binding MontoAnterior, StringFormat=N2}"
                                            Width="105"/>

                        <DataGridTextColumn Header="Nuevo"
                                            Binding="{Binding MontoNuevo, StringFormat=N2}"
                                            Width="105"/>

                        <DataGridTextColumn Header="Motivo"
                                            Binding="{Binding Motivo}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Responsable"
                                            Binding="{Binding Responsable}"
                                            Width="160"/>

                        <DataGridTextColumn Header="Fecha"
                                            Binding="{Binding FechaLocal}"
                                            Width="145"/>

                    </DataGrid.Columns>

                </DataGrid>

            </DockPanel>
        </Border>

        <TextBlock Grid.Row="5"
                   x:Name="TxtEstado"
                   Text="Cargando obligaciones..."
                   Foreground="#375A77"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"/>

    </Grid>

</Window>