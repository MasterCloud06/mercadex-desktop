
<UserControl x:Class="Mercadex.Desktop.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DFE6EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>

        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#60748A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>

        <Style x:Key="Numero" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#173B5C"/>
            <Setter Property="FontSize" Value="29"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="#F3F6FA">

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="28">

                <!-- ENCABEZADO -->

                <Grid Margin="0,0,0,22">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="Panel principal"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#173B5C"/>

                        <TextBlock Text="Resumen general de Mercadex"
                                   FontSize="15"
                                   Foreground="#61758B"
                                   Margin="0,6,0,0"/>

                        <TextBlock x:Name="TxtFecha"
                                   FontSize="13"
                                   Foreground="#61758B"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Actualizar datos"
                            Click="Actualizar_Click"
                            Width="145"
                            Height="38"
                            VerticalAlignment="Center"
                            Background="#1F4E79"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"/>

                </Grid>

                <!-- ESTADO DE CONEXIÓN -->

                <Border Background="#E7F0F9"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,0,0,22">

                    <TextBlock x:Name="TxtEstado"
                               Text="Preparando el panel..."
                               Foreground="#1F4E79"
                               TextWrapping="Wrap"/>

                </Border>

                <!-- RESUMEN DE LOCALES -->

                <TextBlock Text="Unidades comerciales"
                           FontSize="21"
                           FontWeight="SemiBold"
                           Foreground="#173B5C"
                           Margin="0,0,0,15"/>

                <UniformGrid Columns="2"
                             Margin="0,0,0,12">

                    <Border Style="{StaticResource Tarjeta}">

                        <StackPanel>

                            <TextBlock Text="Casetas registradas"
                                       Style="{StaticResource Etiqueta}"/>

                            <TextBlock x:Name="TxtCasetas"
                                       Text="—"
                                       Style="{StaticResource Numero}"/>

                        </StackPanel>

                    </Border>

                    <Border Style="{StaticResource Tarjeta}">

                        <StackPanel>

                            <TextBlock Text="Comedores registrados"
                                       Style="{StaticResource Etiqueta}"/>

                            <TextBlock x:Name="TxtComedores"
                                       Text="—"
                                       Style="{StaticResource Numero}"/>

                        </StackPanel>

                    </Border>

                    <Border Style="{StaticResource Tarjeta}">

                        <StackPanel>

                            <TextBlock Text="Ambulantes registrados"
                                       Style="{StaticResource Etiqueta}"/>

                            <TextBlock x:Name="TxtAmbulantes"
                                       Text="—"
                                       Style="{StaticResource Numero}"/>

                        </StackPanel>

                    </Border>

                    <Border Style="{StaticResource Tarjeta}">

                        <StackPanel>

                            <TextBlock Text="Total de unidades activas"
                                       Style="{StaticResource Etiqueta}"/>

                            <TextBlock x:Name="TxtTotalUnidades"
                                       Text="—"
                                       Style="{StaticResource Numero}"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>

                <!-- RESUMEN DE COBRANZA -->

                <TextBlock Text="Cobranza"
                           FontSize="21"
                           FontWeight="SemiBold"
                           Foreground="#173B5C"
                           Margin="0,4,0,15"/>

                <UniformGrid Columns="2"
                             Margin="0,0,0,12">

                    <Border Style="{StaticResource Tarjeta}">

                        <StackPanel>

                            <TextBlock Text="Obligaciones pendientes"
                                       Style="{StaticResource Etiqueta}"/>

                            <TextBlock x:Name="TxtPendientes"
                                       Text="—"
                                       Style="{StaticResource Numero}"/>

                            <TextBlock Text="Deudas aún no pagadas"
                                       Foreground="#75879A"
                                       Margin="0,7,0,0"/>

                        </StackPanel>

                    </Border>

                    <Border Style="{StaticResource Tarjeta}">

                        <StackPanel>

                            <TextBlock Text="Recibos registrados"
                                       Style="{StaticResource Etiqueta}"/>

                            <TextBlock x:Name="TxtRecibos"
                                       Text="—"
                                       Style="{StaticResource Numero}"/>

                            <TextBlock Text="Incluye recibos anulados"
                                       Foreground="#75879A"
                                       Margin="0,7,0,0"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>

                <!-- IMPORTES SEPARADOS POR MONEDA -->

                <TextBlock Text="Importes pendientes"
                           FontSize="21"
                           FontWeight="SemiBold"
                           Foreground="#173B5C"
                           Margin="0,4,0,15"/>

                <UniformGrid Columns="2">

                    <Border Style="{StaticResource Tarjeta}">

                        <StackPanel>

                            <TextBlock Text="Deudas en bolivianos"
                                       Style="{StaticResource Etiqueta}"/>

                            <TextBlock x:Name="TxtPendienteBob"
                                       Text="—"
                                       Style="{StaticResource Numero}"/>

                            <TextBlock Text="BOB"
                                       Foreground="#75879A"
                                       Margin="0,7,0,0"/>

                        </StackPanel>

                    </Border>

                    <Border Style="{StaticResource Tarjeta}">

                        <StackPanel>

                            <TextBlock Text="Deudas en dólares"
                                       Style="{StaticResource Etiqueta}"/>

                            <TextBlock x:Name="TxtPendienteUsd"
                                       Text="—"
                                       Style="{StaticResource Numero}"/>

                            <TextBlock Text="USD"
                                       Foreground="#75879A"
                                       Margin="0,7,0,0"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>

                <!-- INFORMACIÓN -->

                <Border Background="#FFF4D6"
                        Padding="14"
                        CornerRadius="7"
                        Margin="0,10,14,10">

                    <TextBlock
                        Text="Este panel muestra información registrada en el sistema. Los importes pendientes no son dinero recaudado. Las deudas en BOB y USD se presentan por separado."
                        TextWrapping="Wrap"
                        Foreground="#73551A"/>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>
