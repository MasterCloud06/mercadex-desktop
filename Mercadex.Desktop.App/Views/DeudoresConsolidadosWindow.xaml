<Window x:Class="Mercadex.Desktop.App.Views.DeudoresConsolidadosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mercadex - Deudas consolidadas"
        Width="1170"
        Height="810"
        MinWidth="920"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6FA"
        FontFamily="Segoe UI">

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1.15*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Deudas consolidadas por caseta"
                       FontSize="27"
                       FontWeight="Bold"
                       Foreground="#173B5C"/>

            <TextBlock
                Text="Obligaciones pendientes agrupadas sin duplicar casetas ni mezclar monedas"
                Foreground="#60748A"
                Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#DFE6EE"
                BorderThickness="1"
                CornerRadius="9"
                Padding="14"
                Margin="0,0,0,12">

            <WrapPanel>

                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Buscar caseta"/>
                    <TextBox x:Name="TxtBuscar"
                             Width="160"
                             Height="34"
                             Padding="7,5"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Concepto"/>
                    <ComboBox x:Name="CmbConceptos"
                              Width="185"
                              Height="34"
                              DisplayMemberPath="Nombre"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Hasta período"/>
                    <DatePicker x:Name="FechaLimite"
                                Width="145"
                                Height="34"
                                SelectedDateFormat="Short"/>
                </StackPanel>

                <CheckBox x:Name="ChkTodos"
                          Content="Todos los períodos"
                          VerticalAlignment="Center"
                          Margin="0,15,14,0"/>

                <Button Content="Aplicar filtros"
                        Width="125"
                        Height="34"
                        Margin="0,16,9,0"
                        Click="AplicarFiltros_Click"
                        Style="{StaticResource Mx.SecondaryButton}"/>

                <Button x:Name="BtnActualizar"
                        Content="Actualizar datos"
                        Width="130"
                        Height="34"
                        Margin="0,16,0,0"
                        Click="Actualizar_Click"
                        Style="{StaticResource Mx.PrimaryButton}"/>

            </WrapPanel>

        </Border>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DFE6EE"
                BorderThickness="1"
                CornerRadius="9"
                Padding="14"
                Margin="0,0,0,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Casetas con pendientes"
                               Foreground="#60748A"/>
                    <TextBlock x:Name="TxtCasetas"
                               Text="—"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#173B5C"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Obligaciones pendientes"
                               Foreground="#60748A"/>
                    <TextBlock x:Name="TxtObligaciones"
                               Text="—"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#173B5C"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Total pendiente por moneda"
                               Foreground="#60748A"/>
                    <TextBlock x:Name="TxtTotales"
                               Text="Sin consultar"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#173B5C"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

        </Border>

        <GroupBox Grid.Row="3"
                  Header="Consolidado por caseta y moneda"
                  Margin="0,0,0,12"
                  BorderBrush="#DFE6EE"
                  Background="White">

            <DataGrid x:Name="TablaResumen"
                      Margin="8"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionChanged="TablaResumen_SelectionChanged"
                      AlternatingRowBackground="#F1F6FA">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Caseta"
                                        Binding="{Binding Caseta}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Moneda"
                                        Binding="{Binding Moneda}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Obligaciones"
                                        Binding="{Binding Cantidad}"
                                        Width="135"/>

                    <DataGridTextColumn Header="Períodos"
                                        Binding="{Binding Periodos}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Total pendiente"
                                        Binding="{Binding Total, StringFormat=N2}"
                                        Width="180"/>

                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Row="4"
                  Margin="0,0,0,12"
                  BorderBrush="#DFE6EE"
                  Background="White">

            <GroupBox.Header>
                <TextBlock x:Name="TxtDetalle"
                           Text="Detalle de obligaciones"/>
            </GroupBox.Header>

            <DataGrid x:Name="TablaDetalle"
                      Margin="8"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      AlternatingRowBackground="#F1F6FA">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Concepto"
                                        Binding="{Binding Concepto}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Período"
                                        Binding="{Binding Periodo}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Moneda"
                                        Binding="{Binding Moneda}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Pendiente"
                                        Binding="{Binding Monto, StringFormat=N2}"
                                        Width="170"/>

                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <Border Grid.Row="5"
                Background="White"
                BorderBrush="#DFE6EE"
                BorderThickness="1"
                CornerRadius="9"
                Padding="12">

            <DockPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">

                    <Button x:Name="BtnImprimir"
                            Content="Imprimir listado / PDF"
                            Width="180"
                            Height="35"
                            IsEnabled="False"
                            Margin="0,0,10,0"
                            Click="Imprimir_Click"
                            Style="{StaticResource Mx.PrimaryButton}"/>

                    <Button Content="Cerrar"
                            Width="95"
                            Height="35"
                            Click="Cerrar_Click"
                            Style="{StaticResource Mx.SecondaryButton}"/>
                </StackPanel>

                <StackPanel Margin="0,0,15,0">

                    <TextBlock x:Name="TxtEstado"
                               Text="Preparando consulta..."
                               Foreground="#375A77"
                               TextWrapping="Wrap"/>

                    <TextBlock
                        Text="Pendiente no significa necesariamente vencido. Consulta de solo lectura."
                        Foreground="#9B6415"
                        FontSize="11"
                        TextWrapping="Wrap"
                        Margin="0,4,0,0"/>

                </StackPanel>

            </DockPanel>
        </Border>

    </Grid>
</Window>