<Window x:Class="Mercadex.Desktop.App.Views.DocumentosKardexWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mercadex - Documentos del kardex"
        Width="1080"
        Height="780"
        MinWidth="850"
        MinHeight="630"
        Background="#F3F6FA"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">

            <TextBlock Text="Documentos del kardex"
                       FontSize="27"
                       FontWeight="Bold"
                       Foreground="#173B5C"/>

            <TextBlock
                Text="Documentos de socios, titularidad, aportes y fotografías"
                Foreground="#60748A"
                Margin="0,5,0,0"/>

        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#DFE6EE"
                BorderThickness="1"
                CornerRadius="9"
                Padding="15"
                Margin="0,0,0,12">

            <WrapPanel>

                <StackPanel Margin="0,0,14,8">
                    <TextBlock Text="Socio"/>
                    <ComboBox x:Name="CmbSocios"
                              Width="340"
                              Height="35"
                              DisplayMemberPath="Etiqueta"
                              SelectionChanged="Socio_Changed"/>
                </StackPanel>

                <StackPanel Margin="0,0,14,8">
                    <TextBlock Text="Caseta asignada (opcional)"/>
                    <ComboBox x:Name="CmbCasetas"
                              Width="230"
                              Height="35"
                              DisplayMemberPath="Nombre"/>
                </StackPanel>

                <Button Content="Consultar documentos"
                        Width="170"
                        Height="35"
                        Margin="0,18,0,0"
                        Click="Consultar_Click"
                        Style="{StaticResource Mx.SecondaryButton}"/>

            </WrapPanel>

        </Border>

        <DataGrid Grid.Row="2"
                  x:Name="TablaDocumentos"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionChanged="Documento_Changed"
                  RowHeight="35"
                  ColumnHeaderHeight="38"
                  AlternatingRowBackground="#F1F6FA"
                  BorderBrush="#DFE6EE">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Tipo"
                                    Binding="{Binding Tipo}"
                                    Width="140"/>

                <DataGridTextColumn Header="Archivo"
                                    Binding="{Binding NombreArchivo}"
                                    Width="*"/>

                <DataGridTextColumn Header="Tamaño KB"
                                    Binding="{Binding TamanoKb, StringFormat=N1}"
                                    Width="110"/>

                <DataGridTextColumn Header="Responsable"
                                    Binding="{Binding RegistradoPor}"
                                    Width="170"/>

                <DataGridTextColumn Header="Fecha"
                                    Binding="{Binding FechaLocal}"
                                    Width="145"/>

            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#DFE6EE"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,12,0,12">

            <WrapPanel>

                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Tipo de documento"/>
                    <ComboBox x:Name="CmbTipos"
                              Width="185"
                              Height="35"
                              DisplayMemberPath="Nombre"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Archivo seleccionado"/>
                    <TextBox x:Name="TxtArchivo"
                             Width="265"
                             Height="35"
                             IsReadOnly="True"/>
                </StackPanel>

                <Button Content="Elegir archivo"
                        Width="120"
                        Height="35"
                        Margin="0,18,10,0"
                        Click="Elegir_Click"
                        Style="{StaticResource Mx.SecondaryButton}"/>

                <Button x:Name="BtnAdjuntar"
                        Content="Adjuntar"
                        Width="110"
                        Height="35"
                        Margin="0,18,10,0"
                        IsEnabled="False"
                        Click="Adjuntar_Click"
                        Style="{StaticResource Mx.PrimaryButton}"/>

                <Button x:Name="BtnDescargar"
                        Content="Descargar"
                        Width="110"
                        Height="35"
                        Margin="0,18,0,0"
                        IsEnabled="False"
                        Click="Descargar_Click"
                        Style="{StaticResource Mx.SecondaryButton}"/>

            </WrapPanel>
        </Border>

        <Border Grid.Row="4"
                Background="White"
                BorderBrush="#DFE6EE"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image x:Name="VistaImagen"
                       Grid.Column="0"
                       Stretch="Uniform"
                       Margin="4"/>

                <StackPanel Grid.Column="1"
                            Margin="18,6,6,6">

                    <TextBlock Text="Vista previa"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#173B5C"/>

                    <TextBlock x:Name="TxtDetalle"
                               Margin="0,8,0,0"
                               Foreground="#60748A"
                               TextWrapping="Wrap"
                               Text="Selecciona un documento para visualizarlo."/>

                </StackPanel>

            </Grid>

        </Border>

        <TextBlock Grid.Row="5"
                   x:Name="TxtEstado"
                   Text="Conectando con Mercadex..."
                   Foreground="#375A77"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"/>

    </Grid>
</Window>