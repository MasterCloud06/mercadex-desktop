<UserControl x:Class="Mercadex.Desktop.App.Views.EgresosView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F3F6FA" FontFamily="Segoe UI" FontSize="14" Language="es-BO">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="18,16,18,20">

            <TextBlock Text="Gastos / Egresos" FontSize="27" FontWeight="Bold" Foreground="#173B5C" />

            <TextBlock Text="Registro, control y reporte de egresos" Margin="0,4,0,14" Foreground="#60748A" FontSize="13" />

            <!-- NUEVO EGRESO -->

            <Border Background="White" BorderBrush="#DFE6EE" BorderThickness="1" CornerRadius="11" Padding="16,14" Margin="0,0,0,12">

                <StackPanel>

                    <TextBlock Text="Registrar nuevo egreso" FontSize="18" FontWeight="SemiBold" Foreground="#173B5C" Margin="0,0,0,12" />

                    <WrapPanel>

                        <StackPanel Width="150" Margin="0,0,14,9">
                            <TextBlock Text="Fecha" FontSize="13" FontWeight="SemiBold" Foreground="#4A5E73" Margin="0,0,0,6" />
                            <DatePicker SelectedDate="{Binding Fecha}" Height="38" FontSize="14" BorderBrush="#C5D1DE" />
                        </StackPanel>

                        <StackPanel Width="180" Margin="0,0,14,9">
                            <TextBlock Text="Categoría" FontSize="13" FontWeight="SemiBold" Foreground="#4A5E73" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaSeleccionada}" Height="38" FontSize="14" BorderBrush="#C5D1DE" Background="White" Padding="7,3" />
                        </StackPanel>

                        <StackPanel Width="280" Margin="0,0,14,9">
                            <TextBlock Text="Concepto" FontSize="13" FontWeight="SemiBold" Foreground="#4A5E73" Margin="0,0,0,6" />
                            <TextBox Text="{Binding Concepto,&#xD;&#xA;                                      UpdateSourceTrigger=PropertyChanged}" Height="38" Style="{StaticResource Mx.TextBox}" FontSize="14" />
                        </StackPanel>

                        <StackPanel Width="250" Margin="0,0,14,9">
                            <TextBlock Text="Beneficiario / proveedor" FontSize="13" FontWeight="SemiBold" Foreground="#4A5E73" Margin="0,0,0,6" />
                            <TextBox Text="{Binding Beneficiario,&#xD;&#xA;                                      UpdateSourceTrigger=PropertyChanged}" Height="38" Style="{StaticResource Mx.TextBox}" FontSize="14" />
                        </StackPanel>

                        <StackPanel Width="130" Margin="0,0,14,9">
                            <TextBlock Text="Monto" FontSize="13" FontWeight="SemiBold" Foreground="#4A5E73" Margin="0,0,0,6" />
                            <TextBox Text="{Binding MontoTexto,&#xD;&#xA;                                      UpdateSourceTrigger=PropertyChanged}" Height="38" Style="{StaticResource Mx.TextBox}" FontSize="14" />
                        </StackPanel>

                        <StackPanel Width="120" Margin="0,0,14,9">
                            <TextBlock Text="Moneda" FontSize="13" FontWeight="SemiBold" Foreground="#4A5E73" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding Monedas}" SelectedItem="{Binding MonedaSeleccionada}" DisplayMemberPath="Codigo" Height="38" FontSize="14" BorderBrush="#C5D1DE" Background="White" Padding="7,3" />
                        </StackPanel>

                        <StackPanel Width="160" Margin="0,0,14,9">
                            <TextBlock Text="Forma de pago" FontSize="13" FontWeight="SemiBold" Foreground="#4A5E73" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding FormasPago}" SelectedItem="{Binding FormaPagoSeleccionada}" Height="38" FontSize="14" BorderBrush="#C5D1DE" Background="White" Padding="7,3" />
                        </StackPanel>

                        <StackPanel Width="180" Margin="0,0,14,9">
                            <TextBlock Text="N.º comprobante" FontSize="13" FontWeight="SemiBold" Foreground="#4A5E73" Margin="0,0,0,6" />
                            <TextBox Text="{Binding NumeroComprobante,&#xD;&#xA;                                      UpdateSourceTrigger=PropertyChanged}" Height="38" Style="{StaticResource Mx.TextBox}" FontSize="14" />
                        </StackPanel>

                    </WrapPanel>

                    <TextBlock Text="Observación" />

                    <TextBox Text="{Binding Observacion,&#xD;&#xA;                              UpdateSourceTrigger=PropertyChanged}" Height="85" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,4,0,14" Padding="10,8" FontSize="14" BorderBrush="#C5D1DE" />

                    <WrapPanel>

                        <Button Content="GUARDAR EGRESO" Command="{Binding GuardarCommand}" Background="#1F4E79" Foreground="White" FontWeight="Bold" Height="40" Width="175" Margin="0,0,10,0" Style="{StaticResource Mx.PrimaryButton}" BorderBrush="#1F4E79" />

                        <Button Content="LIMPIAR" Command="{Binding LimpiarCommand}" Height="40" Width="100" Style="{StaticResource Mx.SecondaryButton}" />

                    </WrapPanel>

                </StackPanel>

            </Border>

            <!-- FILTROS -->

            <Border Background="White" BorderBrush="#DFE6EE" BorderThickness="1" CornerRadius="11" Padding="16,14" Margin="0,0,0,12">

                <StackPanel>

                    <TextBlock Text="Historial y reportes" FontSize="18" FontWeight="SemiBold" Foreground="#173B5C" Margin="0,0,0,12" />

                    <WrapPanel>

                        <StackPanel Width="150" Margin="0,0,14,9">
                            <TextBlock Text="Desde" FontSize="13" FontWeight="SemiBold" Foreground="#4A5E73" Margin="0,0,0,6" />
                            <DatePicker SelectedDate="{Binding FechaDesde}" Height="38" FontSize="14" BorderBrush="#C5D1DE" />
                        </StackPanel>

                        <StackPanel Width="150" Margin="0,0,14,9">
                            <TextBlock Text="Hasta" FontSize="13" FontWeight="SemiBold" Foreground="#4A5E73" Margin="0,0,0,6" />
                            <DatePicker SelectedDate="{Binding FechaHasta}" Height="38" FontSize="14" BorderBrush="#C5D1DE" />
                        </StackPanel>

                        <StackPanel Width="190" Margin="0,0,14,9">
                            <TextBlock Text="Categoría" FontSize="13" FontWeight="SemiBold" Foreground="#4A5E73" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding CategoriasFiltro}" SelectedItem="{Binding CategoriaFiltro}" Height="38" FontSize="14" BorderBrush="#C5D1DE" Background="White" Padding="7,3" />
                        </StackPanel>

                        <Button Content="ACTUALIZAR" Command="{Binding ActualizarCommand}" Width="120" Height="40" Margin="0,17,10,10" Background="#1F4E79" Foreground="White" Style="{StaticResource Mx.PrimaryButton}" BorderBrush="#1F4E79" />

                        <Button Content="EXPORTAR CSV" Command="{Binding ExportarCommand}" Width="130" Height="40" Margin="0,17,10,10" Background="#287A42" Foreground="White" Style="{StaticResource Mx.PrimaryButton}" BorderBrush="#287A42" />

                        <Button Content="ANULAR EGRESO" Command="{Binding AnularCommand}" Width="140" Height="40" Margin="0,17,0,10" Background="#A23B3B" Foreground="White" Style="{StaticResource Mx.DangerButton}" BorderBrush="#A23B3B" />

                    </WrapPanel>

                    <Border Background="#E7F0F9" CornerRadius="9" Padding="14,11" Margin="0,6,0,12">

                        <StackPanel>

                            <TextBlock Text="{Binding Mensaje}" Foreground="#173B5C" />

                            <TextBlock Text="{Binding TotalPeriodo}" FontSize="20" FontWeight="Bold" Foreground="#287A42" Margin="0,6,0,0" />

                        </StackPanel>

                    </Border>

                    <TabControl MinHeight="330" Background="White" BorderBrush="#DFE6EE">

                        <TabItem Header="Historial de egresos" FontSize="13" FontWeight="SemiBold" Foreground="#173B5C" Padding="14,8">

                            <DataGrid ItemsSource="{Binding Egresos}" SelectedItem="{Binding EgresoSeleccionado}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" AlternatingRowBackground="#F1F5FA" HorizontalScrollBarVisibility="Auto" Style="{StaticResource Mx.DataGrid}" FontSize="13" RowHeight="36" ColumnHeaderHeight="38" VerticalScrollBarVisibility="Auto" CanUserResizeColumns="True" CanUserSortColumns="True">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="95" />

                                    <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="130" />

                                    <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="*" MinWidth="180" />

                                    <DataGridTextColumn Header="Beneficiario" Binding="{Binding Beneficiario}" Width="170" />

                                    <DataGridTextColumn Header="Moneda" Binding="{Binding MonedaCodigo}" Width="80" />

                                    <DataGridTextColumn Header="Monto" Binding="{Binding Monto,&#xD;&#xA;                                                        StringFormat=N2}" Width="100" />

                                    <DataGridTextColumn Header="Forma de pago" Binding="{Binding FormaPago}" Width="120" />

                                    <DataGridTextColumn Header="Comprobante" Binding="{Binding NumeroComprobante}" Width="120" />

                                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100" />

                                </DataGrid.Columns>

                            </DataGrid>

                        </TabItem>

                        <TabItem Header="Resumen por categoría" FontSize="13" FontWeight="SemiBold" Foreground="#173B5C" Padding="14,8">

                            <DataGrid ItemsSource="{Binding Resumen}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" AlternatingRowBackground="#F1F5FA" Style="{StaticResource Mx.DataGrid}" FontSize="13" RowHeight="36" ColumnHeaderHeight="38" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanUserResizeColumns="True" CanUserSortColumns="True">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="*" />

                                    <DataGridTextColumn Header="Moneda" Binding="{Binding MonedaCodigo}" Width="110" />

                                    <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="120" />

                                    <DataGridTextColumn Header="Total" Binding="{Binding Total,&#xD;&#xA;                                                        StringFormat=N2}" Width="150" />

                                </DataGrid.Columns>

                            </DataGrid>

                        </TabItem>

                    </TabControl>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>