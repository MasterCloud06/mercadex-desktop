
<UserControl x:Class="Mercadex.Desktop.App.Views.ExtractoDeudaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,16">

                <TextBlock Text="Extracto de deuda"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#173B5C"/>

                <TextBlock
                    Text="Consulta de obligaciones pendientes por caseta"
                    Foreground="#60748A"
                    TextWrapping="Wrap"
                    Margin="0,5,0,0"/>
            </StackPanel>

            <!-- BUSCADOR -->

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#DFE6EE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,14">

                <StackPanel>

                    <TextBlock Text="Buscar caseta"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#173B5C"
                               Margin="0,0,0,12"/>

                    <WrapPanel>

                        <StackPanel Width="210"
                                    Margin="0,0,12,12">

                            <TextBlock Text="Número de caseta"
                                       Margin="0,0,0,5"/>

                            <TextBox x:Name="TxtCaseta"
                                     Height="38"
                                     FontSize="17"
                                     Padding="8,0"
                                     VerticalContentAlignment="Center"
                                     KeyDown="Buscar_KeyDown"/>

                        </StackPanel>

                        <Button Content="Consultar"
                                Click="Consultar_Click"
                                Width="130"
                                Height="38"
                                Margin="0,20,0,12"
                                Background="#1F4E79"
                                Foreground="White"
                                BorderThickness="0"/>

                    </WrapPanel>

                    <ComboBox x:Name="Coincidencias"
                              DisplayMemberPath="Etiqueta"
                              SelectionChanged="Coincidencias_SelectionChanged"
                              Visibility="Collapsed"
                              Width="350"
                              MaxWidth="350"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,12"/>

                    <TextBlock x:Name="TxtEstado"
                               Text="Introduce una caseta y presiona Enter."
                               Foreground="#1F4E79"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </Border>

            <!-- DOCUMENTO -->

            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#DFE6EE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">

                <StackPanel>

                    <TextBlock Text="DEUDAS POR PAGAR"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#A52A2A"
                               TextAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock
                        Text="EXTRACTO INFORMATIVO - NO ES RECIBO DE PAGO"
                        FontSize="13"
                        FontWeight="SemiBold"
                        TextAlignment="Center"
                        Foreground="#A52A2A"
                        TextWrapping="Wrap"
                        Margin="0,0,0,20"/>

                    <TextBlock x:Name="TxtUnidad"
                               Text="Caseta: sin seleccionar"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBlock x:Name="TxtFecha"
                               Margin="0,0,0,15"/>

                    <DataGrid x:Name="TablaDeudas"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              AlternatingRowBackground="#F1F5FA"
                              MinHeight="180"
                              MaxHeight="340"
                              HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="Servicio"
                                Binding="{Binding Concepto}"
                                Width="*"
                                MinWidth="150"/>

                            <DataGridTextColumn
                                Header="Período"
                                Binding="{Binding Periodo}"
                                Width="95"/>

                            <DataGridTextColumn
                                Header="Fecha de emisión"
                                Binding="{Binding Fecha}"
                                Width="125"/>

                            <DataGridTextColumn
                                Header="Moneda"
                                Binding="{Binding Moneda}"
                                Width="85"/>

                            <DataGridTextColumn
                                Header="Saldo"
                                Binding="{Binding Monto, StringFormat=N2}"
                                Width="110"/>

                            <DataGridTextColumn
                                Header="Nota"
                                Binding="{Binding Nota}"
                                Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#7A5200"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="ToolTip" Value="{Binding NotaDetalle}"/>
                                        <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                    <Border Background="#E8F0F8"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,15,0,15">

                        <StackPanel>

                            <TextBlock
                                Text="TOTAL DE DEUDAS PENDIENTES"
                                FontWeight="SemiBold"
                                Foreground="#173B5C"/>

                            <TextBlock x:Name="TxtTotales"
                                       Text="Sin consultar"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       Foreground="#173B5C"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>

                    <Button x:Name="BtnImprimir"
                            Content="Imprimir extracto de deuda"
                            Click="Imprimir_Click"
                            IsEnabled="False"
                            Height="42"
                            HorizontalAlignment="Right"
                            Padding="20,0"
                            Background="#287A42"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"/>

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>
