<UserControl x:Class="Mercadex.Desktop.App.Views.InformeIngresosGastosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FA"
             FontFamily="{StaticResource Mx.Font}">

    <UserControl.Resources>
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DFE6EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5E73"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14">

            <TextBlock Text="Informe de Ingresos y Gastos" FontSize="22" FontWeight="Bold" Foreground="#173B5C"/>
            <TextBlock Text="Ingresos por concepto (cobros válidos), egresos por categoría (no anulados) y saldo del período. Cada moneda por separado."
                       Foreground="#60748A" TextWrapping="Wrap" Margin="0,4,0,14"/>

            <!-- FILTROS -->
            <Border Style="{StaticResource Tarjeta}">
                <WrapPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Desde" Style="{StaticResource Etiqueta}"/>
                        <DatePicker x:Name="Desde" Width="150" Height="34"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Hasta" Style="{StaticResource Etiqueta}"/>
                        <DatePicker x:Name="Hasta" Width="150" Height="34"/>
                    </StackPanel>
                    <Button Content="Este mes" Click="EsteMes_Click" Height="34" Padding="14,0" Margin="0,0,8,8"
                            VerticalAlignment="Bottom" Style="{StaticResource Mx.SecondaryButton}"/>
                    <Button Content="Mes anterior" Click="MesAnterior_Click" Height="34" Padding="14,0" Margin="0,0,8,8"
                            VerticalAlignment="Bottom" Style="{StaticResource Mx.SecondaryButton}"/>
                    <Button x:Name="BtnGenerar" Content="Generar informe" Click="Generar_Click" Height="34" Padding="18,0"
                            Margin="0,0,16,8" VerticalAlignment="Bottom" Style="{StaticResource Mx.PrimaryButton}"/>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Moneda" Style="{StaticResource Etiqueta}"/>
                        <ComboBox x:Name="SelectorMoneda" Width="110" Height="34" DisplayMemberPath="Moneda"
                                  SelectionChanged="Moneda_Changed"/>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <TextBlock x:Name="TxtEstado" Text="Selecciona el período y pulsa Generar informe." Foreground="#355D7E"
                       TextWrapping="Wrap" Margin="2,0,0,12"/>

            <!-- TOTALES -->
            <UniformGrid Columns="3" Margin="0,0,0,14">
                <Border Background="White" BorderBrush="#DFE6EE" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Ingresos" Style="{StaticResource Etiqueta}" Margin="0"/>
                        <TextBlock x:Name="TotIngresos" Text="—" FontSize="24" FontWeight="Bold" Foreground="#173B5C" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TotIngresosN" Text=" " FontSize="12" Foreground="#7A8A9C"/>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#DFE6EE" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Egresos" Style="{StaticResource Etiqueta}" Margin="0"/>
                        <TextBlock x:Name="TotEgresos" Text="—" FontSize="24" FontWeight="Bold" Foreground="#173B5C" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TotEgresosN" Text=" " FontSize="12" Foreground="#7A8A9C"/>
                    </StackPanel>
                </Border>
                <Border x:Name="CajaSaldo" Background="#1F4E79" CornerRadius="10" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Saldo del período" FontSize="13" FontWeight="SemiBold" Foreground="#D6E4F2"/>
                        <TextBlock x:Name="TotSaldo" Text="—" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TotSaldoN" Text="Ingresos − egresos" FontSize="12" Foreground="#D6E4F2"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- DETALLE -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Text="Ingresos por concepto" FontSize="16" FontWeight="SemiBold" Foreground="#173B5C" Margin="0,0,0,10"/>
                        <DataGrid x:Name="TablaIngresos" Style="{StaticResource Mx.DataGrid}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" MinHeight="160" MaxHeight="420">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="*"/>
                                <DataGridTextColumn Header="Pagos" Binding="{Binding Cantidad}" Width="70"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Text="Egresos por categoría" FontSize="16" FontWeight="SemiBold" Foreground="#173B5C" Margin="0,0,0,10"/>
                        <DataGrid x:Name="TablaEgresos" Style="{StaticResource Mx.DataGrid}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" MinHeight="160" MaxHeight="420">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="*"/>
                                <DataGridTextColumn Header="Egresos" Binding="{Binding Cantidad}" Width="75"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="BtnExcel" Content="Exportar a Excel (uso interno)" Click="Excel_Click" Height="40" Padding="16,0"
                        Margin="0,0,10,0" IsEnabled="False" Style="{StaticResource Mx.SecondaryButton}"/>
                <Button x:Name="BtnImprimir" Content="Vista previa / imprimir / PDF" Click="Imprimir_Click" Height="40" Padding="16,0"
                        IsEnabled="False" Background="#287A42" BorderBrush="#287A42" Foreground="White"
                        Style="{StaticResource Mx.PrimaryButton}"/>
            </WrapPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
