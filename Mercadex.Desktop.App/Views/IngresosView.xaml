
<UserControl x:Class="Mercadex.Desktop.App.Views.IngresosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Mercadex.Desktop.App.Views">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO -->

        <TextBlock Grid.Row="0"
                   Text="Ingresos"
                   FontSize="30"
                   FontWeight="Bold"
                   Margin="0,0,0,18"/>

        <TabControl Grid.Row="1">

            <!-- REGISTRO DE INGRESOS -->

            <TabItem Header="Registrar ingreso">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="15">

                        <TextBlock Text="Registrar nuevo ingreso"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,18"/>

                        <!-- UNIDAD COMERCIAL -->

                        <TextBlock Text="Seleccionar unidad comercial"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Caseta, comedor o puesto"
                                   Margin="0,0,0,5"/>

<!-- BÚSQUEDA RÁPIDA POR NÚMERO DE CASETA -->

<TextBlock Text="Número de caseta"
           FontWeight="SemiBold"
           Margin="0,0,0,5"/>

<TextBox x:Name="BuscarCaseta"
         Width="300"
         Height="38"
         MaxLength="20"
         HorizontalAlignment="Left"
         VerticalContentAlignment="Center"
         FontSize="18"
         Padding="8,0"
         KeyDown="BuscarCaseta_KeyDown"
         ToolTip="Escribe el número de caseta y presiona Enter"
         Margin="0,0,0,5"/>

<TextBlock Text="Escribe el número y presiona Enter."
           Foreground="#60748A"
           Margin="0,0,0,15"/>


                        <ComboBox
                            ItemsSource="{Binding Unidades}"
                            SelectedItem="{Binding UnidadSeleccionada,
                                Mode=TwoWay}"
                            DisplayMemberPath="Codigo"
                            Width="300"
                            Height="35"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,15"/>

                        <!-- MENSAJE DE ESTADO -->

                        <Border Background="#E8F0F8"
                                Padding="12"
                                CornerRadius="5"
                                Margin="0,0,0,20">

                            <TextBlock
                                Text="{Binding Mensaje}"
                                TextWrapping="Wrap"
                                Foreground="#1F4E79"/>

                        </Border>

                        <!-- OBLIGACIONES -->

                        <TextBlock Text="Obligaciones pendientes"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <TextBlock
                            Text="Marque las obligaciones que desea cobrar."
                            Foreground="#666666"
                            Margin="0,0,0,10"/>

                        <DataGrid
                            ItemsSource="{Binding Obligaciones}"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            IsReadOnly="False"
                            SelectionMode="Single"
                            MinHeight="180"
                            MaxHeight="320"
                            Margin="0,0,0,15">

                            <DataGrid.Columns>

                                <DataGridCheckBoxColumn
                                    Header="Cobrar"
                                    Binding="{Binding Seleccionada,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                                    Width="80"/>

                                <DataGridTextColumn
                                    Header="Concepto"
                                    Binding="{Binding NombreConcepto}"
                                    IsReadOnly="True"
                                    Width="*"
                                    MinWidth="160"/>

                                <DataGridTextColumn
                                    Header="Periodo"
                                    Binding="{Binding Periodo}"
                                    IsReadOnly="True"
                                    Width="110"/>

                                <DataGridTextColumn
                                    Header="Importe"
                                    Binding="{Binding Monto,
                                        StringFormat=N2}"
                                    IsReadOnly="True"
                                    Width="120"/>

                                <DataGridTextColumn
                                    Header="Estado"
                                    Binding="{Binding Estado}"
                                    IsReadOnly="True"
                                    Width="110"/>

                            </DataGrid.Columns>

                        </DataGrid>

                        <!-- TOTAL SELECCIONADO -->

                        <Border Background="#E8F0F8"
                                Padding="15"
                                CornerRadius="6"
                                Margin="0,0,0,20">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock
                                    Text="Total seleccionado:"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"
                                    Margin="0,0,15,0"/>

                                <TextBlock
                                    Text="{Binding TotalSeleccionado,
                                        StringFormat=N2}"
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Foreground="#1F4E79"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0"/>

                                <TextBlock
                                    Text="{Binding MonedaSeleccionada.Codigo}"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"
                                    Foreground="#1F4E79"/>

                            </StackPanel>

                        </Border>

                        <!-- DATOS DEL COBRO -->

                        <TextBlock Text="Datos del cobro"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,15"/>

                        <!-- MONEDA -->

                        <TextBlock Text="Moneda"
                                   Margin="0,0,0,5"/>

                        <ComboBox
                            ItemsSource="{Binding Monedas}"
                            SelectedItem="{Binding MonedaSeleccionada,
                                Mode=TwoWay}"
                            DisplayMemberPath="Nombre"
                            Width="300"
                            Height="35"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,15"/>

                        <!-- FORMA DE PAGO -->

                        <TextBlock Text="Forma de pago"
                                   Margin="0,0,0,5"/>

                        <ComboBox
                            ItemsSource="{Binding FormasPagoDisponibles}"
                            SelectedItem="{Binding FormaPagoSeleccionada,
                                Mode=TwoWay}"
                            DisplayMemberPath="Nombre"
                            Width="300"
                            Height="35"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,15"/>

                        <!-- PAGADOR -->

                        <TextBlock Text="Nombre del pagador"
                                   Margin="0,0,0,5"/>

                        <TextBox
                            Text="{Binding NombrePagador,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                            Width="350"
                            Height="35"
                            MaxLength="200"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,15"/>

                        <!-- REFERENCIA -->

                        <TextBlock
                            Text="Referencia o número de transacción"
                            Margin="0,0,0,5"/>

                        <TextBox
                            Text="{Binding Referencia,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                            Width="350"
                            Height="35"
                            MaxLength="200"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,15"/>


<TextBlock
    Text="Si seleccionas QR, debes introducir el número de transacción antes de guardar el ingreso."
    Foreground="#9A6700"
    FontSize="12"
    TextWrapping="Wrap"
    Margin="0,0,0,15"/>


                        <!-- AVISO SOBRE MONEDAS -->

                        <Border Background="#FFF4D6"
                                Padding="12"
                                CornerRadius="5"
                                Margin="0,0,0,20">

                            <TextBlock
                                Text="Las obligaciones en bolivianos y dólares deben cobrarse por separado. No se realiza conversión automática de moneda."
                                TextWrapping="Wrap"/>

                        </Border>

                        <!-- GUARDAR INGRESO -->

                        <Button
                            Content="GUARDAR INGRESO"
                            Command="{Binding CobrarCommand}"
                            Height="45"
                            Width="300"
                            HorizontalAlignment="Left"
                            Background="#287A42"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Margin="0,0,0,10"/>

                        <TextBlock
                            Text="El número de recibo será asignado automáticamente al registrar el cobro."
                            Foreground="#666666"
                            TextWrapping="Wrap"
                            Margin="0,0,0,15"/>

                    </StackPanel>

                </ScrollViewer>

            </TabItem>

            <!-- CONSULTA Y ESTADÍSTICAS -->

            <TabItem Header="Consultar ingresos">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- FILTROS -->

                    <StackPanel
                        Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,15">

                        <StackPanel Margin="0,0,20,0">

                            <TextBlock Text="Fecha inicio"/>

                            <DatePicker
                                SelectedDate="{Binding FechaInicio,
                                    Mode=TwoWay}"
                                Width="150"/>

                        </StackPanel>

                        <StackPanel Margin="0,0,20,0">

                            <TextBlock Text="Fecha fin"/>

                            <DatePicker
                                SelectedDate="{Binding FechaFin,
                                    Mode=TwoWay}"
                                Width="150"/>

                        </StackPanel>

                        <Button
                            Content="Consultar"
                            Command="{Binding ConsultarCommand}"
                            Width="130"
                            Height="35"
                            VerticalAlignment="Bottom"/>

                    </StackPanel>

                    <!-- INDICADORES -->

                    <Grid Grid.Row="1"
                          Margin="0,0,0,15">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- TOTAL RECAUDADO -->

                        <Border
                            Grid.Column="0"
                            Background="#1F4E79"
                            Padding="15"
                            Margin="4"
                            CornerRadius="6">

                            <StackPanel>

                                <TextBlock
                                    Text="Total ingresos"
                                    Foreground="White"/>

                                <TextBlock
                                    Text="{Binding Resultado.TotalRecaudado,
                                        StringFormat='Bs {0:N2}'}"
                                    Foreground="White"
                                    FontSize="23"
                                    FontWeight="Bold"/>

                            </StackPanel>

                        </Border>

                        <!-- PAGOS -->

                        <Border
                            Grid.Column="1"
                            Background="#2E75B6"
                            Padding="15"
                            Margin="4"
                            CornerRadius="6">

                            <StackPanel>

                                <TextBlock
                                    Text="Pagos"
                                    Foreground="White"/>

                                <TextBlock
                                    Text="{Binding Resultado.CantidadPagos}"
                                    Foreground="White"
                                    FontSize="23"
                                    FontWeight="Bold"/>

                            </StackPanel>

                        </Border>

                        <!-- RECIBOS -->

                        <Border
                            Grid.Column="2"
                            Background="#548235"
                            Padding="15"
                            Margin="4"
                            CornerRadius="6">

                            <StackPanel>

                                <TextBlock
                                    Text="Recibos"
                                    Foreground="White"/>

                                <TextBlock
                                    Text="{Binding Resultado.CantidadRecibos}"
                                    Foreground="White"
                                    FontSize="23"
                                    FontWeight="Bold"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                    <!-- TABLAS DE CONSULTA -->

                    <TabControl Grid.Row="2">

                        <!-- MOVIMIENTOS -->

                        <TabItem Header="Movimientos">

                            <DataGrid
                                ItemsSource="{Binding Movimientos}"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                IsReadOnly="True">

                                <DataGrid.Columns>

                                    <DataGridTextColumn
                                        Header="Fecha"
                                        Binding="{Binding Fecha,
                                            StringFormat=d}"
                                        Width="100"/>

                                    <DataGridTextColumn
                                        Header="Recibo"
                                        Binding="{Binding NumeroRecibo}"
                                        Width="80"/>

                                    <DataGridTextColumn
                                        Header="Local"
                                        Binding="{Binding CodigoUnidad}"
                                        Width="100"/>

                                    <DataGridTextColumn
                                        Header="Bloque"
                                        Binding="{Binding Bloque}"
                                        Width="80"/>

                                    <DataGridTextColumn
                                        Header="Socio"
                                        Binding="{Binding NombreSocio}"
                                        Width="160"/>

                                    <DataGridTextColumn
                                        Header="Pagador"
                                        Binding="{Binding NombrePagador}"
                                        Width="160"/>

                                    <DataGridTextColumn
                                        Header="Forma de pago"
                                        Binding="{Binding FormaPago}"
                                        Width="120"/>

                                    <DataGridTextColumn
                                        Header="Monto"
                                        Binding="{Binding Monto,
                                            StringFormat=N2}"
                                        Width="120"/>

                                    <DataGridTextColumn
                                        Header="Estado"
                                        Binding="{Binding Estado}"
                                        Width="100"/>

                                </DataGrid.Columns>

                            </DataGrid>

                        </TabItem>

                        <!-- FORMAS DE PAGO -->

                        <TabItem Header="Formas de pago">

                            <DataGrid
                                ItemsSource="{Binding FormasPago}"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                IsReadOnly="True">

                                <DataGrid.Columns>

                                    <DataGridTextColumn
                                        Header="Forma de pago"
                                        Binding="{Binding FormaPago}"
                                        Width="200"/>

                                    <DataGridTextColumn
                                        Header="Cantidad"
                                        Binding="{Binding Cantidad}"
                                        Width="120"/>

                                    <DataGridTextColumn
                                        Header="Total"
                                        Binding="{Binding Total,
                                            StringFormat=N2}"
                                        Width="150"/>

                                </DataGrid.Columns>

                            </DataGrid>

                        </TabItem>

                    </TabControl>

                </Grid>

            </TabItem>

            <!-- ARQUEO DIARIO -->

            <TabItem Header="Arqueo diario">
                <local:ArqueoDiarioView/>
            </TabItem>

        </TabControl>

    </Grid>

</UserControl>
