<UserControl x:Class="Mercadex.Desktop.App.Views.IngresosView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Mercadex.Desktop.App.Views" Background="#F3F6FA" FontFamily="Segoe UI" FontSize="14" Language="es-BO"><Grid Margin="18,14,18,18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><!-- TÍTULO --><TextBlock Grid.Row="0" Text="Ingresos" FontSize="27" FontWeight="Bold" Margin="0,0,0,14" Foreground="#173B5C" /><TabControl Grid.Row="1"><!-- REGISTRO DE INGRESOS --><TabItem Header="Registrar ingreso" FontSize="14" FontWeight="SemiBold" Foreground="#173B5C" Padding="15,9"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="14,16,14,16"><TextBlock Text="Registrar nuevo ingreso" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,16" Foreground="#173B5C" /><Border Background="White" BorderBrush="#DFE6EE" BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,10"><StackPanel><!-- UNIDAD COMERCIAL --><TextBlock Text="Seleccionar unidad comercial" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#173B5C" /><WrapPanel Orientation="Horizontal" Margin="0,0,0,3"><StackPanel Width="265" Margin="0,0,18,6"><TextBlock Text="Número de caseta" FontWeight="SemiBold" Margin="0,0,0,5" /><TextBox x:Name="BuscarCaseta" Width="250" Height="36" MaxLength="20" HorizontalAlignment="Left" VerticalContentAlignment="Center" FontSize="14" KeyDown="BuscarCaseta_KeyDown" ToolTip="Escribe el número de caseta y presiona Enter" Margin="0,0,0,4" Style="{StaticResource Mx.TextBox}" /><TextBlock Text="Escribe el número y presiona Enter." Foreground="#60748A" Margin="0" FontSize="12" /></StackPanel><StackPanel Margin="0,0,18,6"><TextBlock Text="Unidad seleccionada" Margin="0,0,0,5" /><Border Background="#E8F0F8" BorderBrush="#C5D1DE" BorderThickness="1" CornerRadius="6" Padding="12,0" MinWidth="250" Height="36"><TextBlock Text="{Binding UnidadSeleccionada.Descripcion, FallbackValue=Ninguna, TargetNullValue=Ninguna}" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="#173B5C" /></Border></StackPanel></WrapPanel><!-- BÚSQUEDA RÁPIDA POR NÚMERO DE CASETA --><!-- MENSAJE DE ESTADO --><Border Background="#E8F0F8" Padding="10,8" CornerRadius="5" Margin="0,5,0,0"><TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" Foreground="#1F4E79" /></Border></StackPanel></Border><Border Background="White" BorderBrush="#DFE6EE" BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,10"><StackPanel><!-- OBLIGACIONES --><TextBlock Text="Obligaciones pendientes" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,7" Foreground="#173B5C" /><TextBlock Text="Marque las obligaciones que desea cobrar." Foreground="#666666" Margin="0,0,0,8" /><DataGrid ItemsSource="{Binding Obligaciones}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False" SelectionMode="Single" MinHeight="78" MaxHeight="190" Margin="0,0,0,10" Style="{StaticResource Mx.DataGrid}"><DataGrid.Columns><DataGridCheckBoxColumn Header="Cobrar" Binding="{Binding Seleccionada,&#xA;                                        Mode=TwoWay,&#xA;                                        UpdateSourceTrigger=PropertyChanged}" Width="80" /><DataGridTextColumn Header="Concepto" Binding="{Binding NombreConcepto}" IsReadOnly="True" Width="*" MinWidth="160" /><DataGridTextColumn Header="Periodo" Binding="{Binding Periodo}" IsReadOnly="True" Width="110" /><DataGridTextColumn Header="Importe" Binding="{Binding Monto,&#xA;                                        StringFormat=N2}" IsReadOnly="True" Width="120" /><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" IsReadOnly="True" Width="110" /></DataGrid.Columns></DataGrid><!-- TOTAL SELECCIONADO --><Border Background="#E8F0F8" Padding="11,9" CornerRadius="6" Margin="0,0,0,2"><StackPanel Orientation="Horizontal"><TextBlock Text="Total seleccionado:" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" /><TextBlock Text="{Binding TotalSeleccionado,&#xA;                                        StringFormat=N2}" FontSize="22" FontWeight="Bold" Foreground="#1F4E79" VerticalAlignment="Center" Margin="0,0,10,0" /><TextBlock Text="{Binding MonedaSeleccionada.Codigo}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#1F4E79" /></StackPanel></Border></StackPanel></Border><Border Background="White" BorderBrush="#DFE6EE" BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,10"><StackPanel><!-- DATOS DEL COBRO --><TextBlock Text="Datos del cobro" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#173B5C" /><WrapPanel Margin="0,0,0,2"><StackPanel Width="265" Margin="0,0,18,6"><TextBlock Text="Moneda" Margin="0,0,0,5" FontSize="13" Foreground="#4A5E73" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding Monedas}" SelectedItem="{Binding MonedaSeleccionada,&#xA;                                Mode=TwoWay}" DisplayMemberPath="Nombre" Width="250" Height="36" HorizontalAlignment="Left" Margin="0,0,0,5" FontSize="14" Background="White" BorderBrush="#C5D1DE" Padding="8,3" /></StackPanel><StackPanel Width="265" Margin="0,0,18,6"><TextBlock Text="Forma de pago" Margin="0,0,0,5" FontSize="13" Foreground="#4A5E73" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding FormasPagoDisponibles}" SelectedItem="{Binding FormaPagoSeleccionada,&#xA;                                Mode=TwoWay}" DisplayMemberPath="Nombre" Width="250" Height="36" HorizontalAlignment="Left" Margin="0,0,0,5" FontSize="14" Background="White" BorderBrush="#C5D1DE" Padding="8,3" /></StackPanel></WrapPanel><WrapPanel Margin="0,0,0,2"><StackPanel Width="265" Margin="0,0,18,6"><TextBlock Text="Nombre del pagador" Margin="0,0,0,5" FontSize="13" Foreground="#4A5E73" FontWeight="SemiBold" /><TextBox Text="{Binding NombrePagador,&#xA;                                Mode=TwoWay,&#xA;                                UpdateSourceTrigger=PropertyChanged}" Width="250" Height="36" MaxLength="200" HorizontalAlignment="Left" Margin="0,0,0,5" Style="{StaticResource Mx.TextBox}" FontSize="14" /></StackPanel><StackPanel Width="265" Margin="0,0,18,6"><TextBlock Text="Referencia o número de transacción" Margin="0,0,0,5" FontSize="13" Foreground="#4A5E73" FontWeight="SemiBold" /><TextBox Text="{Binding Referencia,&#xA;                                Mode=TwoWay,&#xA;                                UpdateSourceTrigger=PropertyChanged}" Width="250" Height="36" MaxLength="200" HorizontalAlignment="Left" Margin="0,0,0,5" Style="{StaticResource Mx.TextBox}" FontSize="14" /></StackPanel></WrapPanel><!-- MONEDA --><!-- FORMA DE PAGO --><!-- PAGADOR --><!-- REFERENCIA --><TextBlock Text="Si seleccionas QR, debes introducir el número de transacción antes de guardar el ingreso." Foreground="#9A6700" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,15" /><!-- AVISO SOBRE MONEDAS --><Border Background="#FFF4D6" Padding="12" CornerRadius="5" Margin="0,0,0,20"><TextBlock Text="Las obligaciones en bolivianos y dólares deben cobrarse por separado. No se realiza conversión automática de moneda." TextWrapping="Wrap" /></Border><!-- GUARDAR INGRESO --><Button Content="GUARDAR INGRESO" Command="{Binding CobrarCommand}" Height="43" Width="250" HorizontalAlignment="Left" Background="#287A42" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Margin="0,0,0,10" Style="{StaticResource Mx.PrimaryButton}" BorderBrush="#287A42" /><TextBlock Text="El número de recibo será asignado automáticamente al registrar el cobro." Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,15" /></StackPanel></Border></StackPanel></ScrollViewer></TabItem><!-- CONSULTA Y ESTADÍSTICAS --><TabItem Header="Consultar ingresos" FontSize="14" FontWeight="SemiBold" Foreground="#173B5C" Padding="15,9"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><!-- FILTROS --><Border Grid.Row="0" Background="White" BorderBrush="#DFE6EE" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,14"><StackPanel Orientation="Horizontal" Margin="0,0,0,15"><StackPanel Margin="0,0,20,0"><TextBlock Text="Fecha inicio" FontSize="13" Foreground="#4A5E73" FontWeight="SemiBold" /><DatePicker SelectedDate="{Binding FechaInicio,&#xA;                                    Mode=TwoWay}" Width="150" FontSize="14" BorderBrush="#C5D1DE" /></StackPanel><StackPanel Margin="0,0,20,0"><TextBlock Text="Fecha fin" FontSize="13" Foreground="#4A5E73" FontWeight="SemiBold" /><DatePicker SelectedDate="{Binding FechaFin,&#xA;                                    Mode=TwoWay}" Width="150" FontSize="14" BorderBrush="#C5D1DE" /></StackPanel><Button Content="Consultar" Command="{Binding ConsultarCommand}" Width="130" Height="38" VerticalAlignment="Bottom" Style="{StaticResource Mx.PrimaryButton}" /></StackPanel></Border><!-- INDICADORES --><Grid Grid.Row="1" Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><!-- TOTAL RECAUDADO --><Border Grid.Column="0" Background="#1F4E79" Padding="15,12" Margin="4" CornerRadius="10"><StackPanel><TextBlock Text="Total ingresos" Foreground="White" /><TextBlock Text="{Binding Resultado.TotalRecaudado,&#xA;                                        StringFormat='Bs {0:N2}'}" Foreground="White" FontSize="23" FontWeight="Bold" /></StackPanel></Border><!-- PAGOS --><Border Grid.Column="1" Background="#2E75B6" Padding="15,12" Margin="4" CornerRadius="10"><StackPanel><TextBlock Text="Pagos" Foreground="White" /><TextBlock Text="{Binding Resultado.CantidadPagos}" Foreground="White" FontSize="23" FontWeight="Bold" /></StackPanel></Border><!-- RECIBOS --><Border Grid.Column="2" Background="#548235" Padding="15,12" Margin="4" CornerRadius="10"><StackPanel><TextBlock Text="Recibos" Foreground="White" /><TextBlock Text="{Binding Resultado.CantidadRecibos}" Foreground="White" FontSize="23" FontWeight="Bold" /></StackPanel></Border></Grid><!-- TABLAS DE CONSULTA --><TabControl Grid.Row="2"><!-- MOVIMIENTOS --><TabItem Header="Movimientos" FontSize="14" FontWeight="SemiBold" Foreground="#173B5C" Padding="15,9"><DataGrid ItemsSource="{Binding Movimientos}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Style="{StaticResource Mx.DataGrid}"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha,&#xA;                                            StringFormat=d}" Width="100" /><DataGridTextColumn Header="Recibo" Binding="{Binding NumeroRecibo}" Width="80" /><DataGridTextColumn Header="Local" Binding="{Binding CodigoUnidad}" Width="100" /><DataGridTextColumn Header="Bloque" Binding="{Binding Bloque}" Width="80" /><DataGridTextColumn Header="Socio" Binding="{Binding NombreSocio}" Width="160" /><DataGridTextColumn Header="Pagador" Binding="{Binding NombrePagador}" Width="160" /><DataGridTextColumn Header="Forma de pago" Binding="{Binding FormaPago}" Width="120" /><DataGridTextColumn Header="Monto" Binding="{Binding Monto,&#xA;                                            StringFormat=N2}" Width="120" /><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100" /></DataGrid.Columns></DataGrid></TabItem><!-- FORMAS DE PAGO --><TabItem Header="Formas de pago" FontSize="14" FontWeight="SemiBold" Foreground="#173B5C" Padding="15,9"><DataGrid ItemsSource="{Binding FormasPago}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Style="{StaticResource Mx.DataGrid}"><DataGrid.Columns><DataGridTextColumn Header="Forma de pago" Binding="{Binding FormaPago}" Width="200" /><DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="120" /><DataGridTextColumn Header="Total" Binding="{Binding Total,&#xA;                                            StringFormat=N2}" Width="150" /></DataGrid.Columns></DataGrid></TabItem></TabControl></Grid></TabItem><!-- ARQUEO DIARIO --><TabItem Header="Arqueo diario" FontSize="14" FontWeight="SemiBold" Foreground="#173B5C" Padding="15,9"><local:ArqueoDiarioView /></TabItem></TabControl></Grid></UserControl>