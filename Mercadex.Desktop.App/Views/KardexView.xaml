<UserControl x:Class="Mercadex.Desktop.App.Views.KardexView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F3F6FA" FontFamily="{StaticResource Mx.Font}" FontSize="14" Language="es-BO"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18,16,18,20" MaxWidth="1000"><TextBlock Text="Kardex de casetas" FontSize="27" FontWeight="Bold" Foreground="#173B5C" /><TextBlock Text="Registro de socios y antecedentes de propiedad" Foreground="#60748A" Margin="0,4,0,14" FontSize="13" /><!-- INICIO DE SESIÓN --><!-- SELECCIÓN DE CASETA --><Border Background="White" Padding="16,14" CornerRadius="11" Margin="0,0,0,12" BorderBrush="#DFE6EE" BorderThickness="1"><StackPanel><TextBlock Text="1. Seleccionar caseta" FontSize="18" FontWeight="SemiBold" Foreground="#173B5C" /><ComboBox x:Name="Casetas" DisplayMemberPath="Etiqueta" SelectionChanged="Casetas_SelectionChanged" IsEnabled="True" Width="320" Height="38" HorizontalAlignment="Left" Margin="0,12,0,10" FontSize="14" BorderBrush="#C5D1DE" /><TextBlock x:Name="Ubicacion" Foreground="#60748A" /><Button x:Name="BtnEditar" Content="Ver y editar ficha" Click="Editar_Click" IsEnabled="False" Style="{StaticResource Mx.PrimaryButton}" Width="180" Height="38" HorizontalAlignment="Left" Margin="0,12,0,0" /></StackPanel></Border><!-- FICHA --><Border x:Name="Formulario" Background="White" Padding="16,14" CornerRadius="11" IsEnabled="False" BorderBrush="#DFE6EE" BorderThickness="1" Margin="0,0,0,12"><StackPanel><TextBlock Text="2. Información del Kardex" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" Foreground="#173B5C" /><WrapPanel Margin="0,0,0,4"><StackPanel Width="320" Margin="0,0,16,12"><TextBlock Text="Socio o propietario" FontSize="13" FontWeight="SemiBold" Foreground="#4A5E73" Margin="0,0,0,6" /><ComboBox x:Name="Socios" DisplayMemberPath="NombreCompleto" Height="38" Margin="0" Width="300" HorizontalAlignment="Left" FontSize="14" BorderBrush="#C5D1DE" /></StackPanel><StackPanel Width="320" Margin="0,0,16,12"><TextBlock Text="Fecha de ingreso" FontSize="13" FontWeight="SemiBold" Foreground="#4A5E73" Margin="0,0,0,6" /><DatePicker x:Name="FechaIngreso" Width="300" HorizontalAlignment="Left" Margin="0" Height="38" FontSize="14" BorderBrush="#C5D1DE" /></StackPanel><StackPanel Width="320" Margin="0,0,16,12"><TextBlock Text="Estado de vida" FontSize="13" FontWeight="SemiBold" Foreground="#4A5E73" Margin="0,0,0,6" /><ComboBox x:Name="EstadoVida" Width="300" HorizontalAlignment="Left" Margin="0" Height="38" FontSize="14" BorderBrush="#C5D1DE"><ComboBoxItem Content="Sin especificar" Tag="" /><ComboBoxItem Content="Vivo" Tag="VIVO" /><ComboBoxItem Content="Fallecido" Tag="FALLECIDO" /></ComboBox></StackPanel><StackPanel Width="320" Margin="0,0,16,12"><TextBlock Text="Documento de propiedad" FontSize="13" FontWeight="SemiBold" Foreground="#4A5E73" Margin="0,0,0,6" /><ComboBox x:Name="Documento" Width="300" HorizontalAlignment="Left" Margin="0" Height="38" FontSize="14" BorderBrush="#C5D1DE"><ComboBoxItem Content="Sin especificar" Tag="" /><ComboBoxItem Content="Derechos Reales" Tag="DERECHOS_REALES" /><ComboBoxItem Content="Minuta" Tag="MINUTA" /><ComboBoxItem Content="Otro" Tag="OTRO" /></ComboBox></StackPanel><StackPanel Width="320" Margin="0,0,16,12"><TextBlock Text="Propietario anterior" FontSize="13" FontWeight="SemiBold" Foreground="#4A5E73" Margin="0,0,0,6" /><TextBox x:Name="PropietarioAnterior" MaxLength="300" Height="38" Margin="0" Width="300" HorizontalAlignment="Left" Style="{StaticResource Mx.TextBox}" /></StackPanel><StackPanel Width="320" Margin="0,0,16,12"><TextBlock Text="Aporte de socio" FontSize="13" FontWeight="SemiBold" Foreground="#4A5E73" Margin="0,0,0,6" /><ComboBox x:Name="Aporte" Width="300" HorizontalAlignment="Left" Margin="0" Height="38" FontSize="14" BorderBrush="#C5D1DE"><ComboBoxItem Content="Sin verificar" Tag="" /><ComboBoxItem Content="Pagado" Tag="SI" /><ComboBoxItem Content="Pendiente" Tag="NO" /></ComboBox></StackPanel></WrapPanel><TextBlock Text="Observaciones" FontSize="13" FontWeight="SemiBold" Foreground="#4A5E73" Margin="0,0,0,6" /><TextBox x:Name="Observaciones" Height="95" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14" Style="{StaticResource Mx.TextBox}" MaxWidth="750" VerticalContentAlignment="Top" /><Button x:Name="BtnGuardar" Content="Guardar Kardex" Click="Guardar_Click" Width="170" Height="40" HorizontalAlignment="Left" Background="#287A42" Foreground="White" Style="{StaticResource Mx.PrimaryButton}" BorderBrush="#287A42" /></StackPanel></Border><Border Background="#E7F0F9" BorderBrush="#D7E6F4" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14"><TextBlock x:Name="Estado" Text="Selecciona una caseta para consultar su informacion general." Foreground="#1F4E79" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0" FontSize="13" /></Border></StackPanel></ScrollViewer></UserControl>