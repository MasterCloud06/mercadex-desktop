
<UserControl x:Class="Mercadex.Desktop.App.Views.KardexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25" MaxWidth="900">

            <TextBlock Text="Kardex de casetas"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#173B5C"/>

            <TextBlock Text="Registro de socios y antecedentes de propiedad"
                       Foreground="#60748A"
                       Margin="0,5,0,20"/>

            <!-- INICIO DE SESIÓN -->

            <Border Background="White"
                    Padding="20"
                    CornerRadius="8"
                    Margin="0,0,0,15">

                <StackPanel>

                    <TextBlock Text="1. Acceso del administrador"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <WrapPanel Margin="0,15,0,0">

                        <StackPanel Margin="0,0,15,10">
                            <TextBlock Text="Usuario"/>
                            <TextBox x:Name="Usuario"
                                     Text="admin"
                                     Width="160"
                                     Height="32"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,15,10">
                            <TextBlock Text="Contraseña"/>
                            <PasswordBox x:Name="Clave"
                                         Width="200"
                                         Height="32"/>
                        </StackPanel>

                        <Button x:Name="BtnLogin"
                                Content="Iniciar sesión"
                                Click="Entrar_Click"
                                Width="130"
                                Height="32"
                                Margin="0,18,0,0"/>

                    </WrapPanel>

                </StackPanel>

            </Border>

            <!-- SELECCIÓN DE CASETA -->

            <Border Background="White"
                    Padding="20"
                    CornerRadius="8"
                    Margin="0,0,0,15">

                <StackPanel>

                    <TextBlock Text="2. Seleccionar caseta"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="Casetas"
                              DisplayMemberPath="Etiqueta"
                              SelectionChanged="Casetas_SelectionChanged"
                              IsEnabled="False"
                              Width="300"
                              Height="35"
                              HorizontalAlignment="Left"
                              Margin="0,15,0,10"/>

                    <TextBlock x:Name="Ubicacion"
                               Foreground="#60748A"/>

                </StackPanel>

            </Border>

            <!-- FICHA -->

            <Border x:Name="Formulario"
                    Background="White"
                    Padding="20"
                    CornerRadius="8"
                    IsEnabled="False">

                <StackPanel>

                    <TextBlock Text="3. Información del Kardex"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Socio o propietario"/>

                    <ComboBox x:Name="Socios"
                              DisplayMemberPath="NombreCompleto"
                              Height="35"
                              Margin="0,5,0,15"/>

                    <TextBlock Text="Fecha de ingreso"/>

                    <DatePicker x:Name="FechaIngreso"
                                Width="220"
                                HorizontalAlignment="Left"
                                Margin="0,5,0,15"/>

                    <TextBlock Text="Estado de vida"/>

                    <ComboBox x:Name="EstadoVida"
                              Width="220"
                              HorizontalAlignment="Left"
                              Margin="0,5,0,15">

                        <ComboBoxItem Content="Sin especificar"
                                      Tag=""/>

                        <ComboBoxItem Content="Vivo"
                                      Tag="VIVO"/>

                        <ComboBoxItem Content="Fallecido"
                                      Tag="FALLECIDO"/>

                    </ComboBox>

                    <TextBlock Text="Documento de propiedad"/>

                    <ComboBox x:Name="Documento"
                              Width="260"
                              HorizontalAlignment="Left"
                              Margin="0,5,0,15">

                        <ComboBoxItem Content="Sin especificar"
                                      Tag=""/>

                        <ComboBoxItem Content="Derechos Reales"
                                      Tag="DERECHOS_REALES"/>

                        <ComboBoxItem Content="Minuta"
                                      Tag="MINUTA"/>

                        <ComboBoxItem Content="Otro"
                                      Tag="OTRO"/>

                    </ComboBox>

                    <TextBlock Text="Propietario anterior"/>

                    <TextBox x:Name="PropietarioAnterior"
                             MaxLength="300"
                             Height="32"
                             Margin="0,5,0,15"/>

                    <TextBlock Text="Aporte de socio"/>

                    <ComboBox x:Name="Aporte"
                              Width="220"
                              HorizontalAlignment="Left"
                              Margin="0,5,0,15">

                        <ComboBoxItem Content="Sin verificar"
                                      Tag=""/>

                        <ComboBoxItem Content="Pagado"
                                      Tag="SI"/>

                        <ComboBoxItem Content="Pendiente"
                                      Tag="NO"/>

                    </ComboBox>

                    <TextBlock Text="Observaciones"/>

                    <TextBox x:Name="Observaciones"
                             Height="100"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,5,0,15"/>

                    <Button x:Name="BtnGuardar"
                            Content="Guardar Kardex"
                            Click="Guardar_Click"
                            Width="160"
                            Height="40"
                            HorizontalAlignment="Left"
                            Background="#287A42"
                            Foreground="White"/>

                </StackPanel>

            </Border>

            <TextBlock x:Name="Estado"
                       Text="Inicia sesión para consultar el Kardex."
                       Foreground="#173B5C"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,15,0,20"/>

        </StackPanel>
    </ScrollViewer>

</UserControl>
