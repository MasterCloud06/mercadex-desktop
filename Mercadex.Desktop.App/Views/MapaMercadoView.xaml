<UserControl x:Class="Mercadex.Desktop.App.Views.MapaMercadoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Mx.Font}"
             Background="#F3F6FA">

    <UserControl.Resources>
        <!-- Cuadro de una unidad en el mapa. -->
        <Style x:Key="Celda" TargetType="Button">
            <Setter Property="Width" Value="92"/>
            <Setter Property="Height" Value="62"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Mx.FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="9,6">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Marco" BorderBrush="#12304D" BorderThickness="2" CornerRadius="8"
                                    Visibility="Hidden" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Marco" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Marco" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="seleccionada">
                                <Setter TargetName="Marco" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Marco" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filtro por situación (chip). -->
        <Style x:Key="Chip" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,2,8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E2A38"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Mx.FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="White" BorderBrush="#D5DEE8" BorderThickness="1"
                                CornerRadius="16" Padding="11,5">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF3F9"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DFEAF6"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1F4E79"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Mapa del mercado" FontSize="27" FontWeight="Bold" Foreground="#12304D"/>
                <TextBlock x:Name="TxtEstado" Text="Cada cuadro es una unidad. El color indica cómo está con sus pagos."
                           Foreground="#5A6B7D" FontSize="13" Margin="0,3,0,0"/>
            </StackPanel>
            <Button x:Name="BtnActualizar" Grid.Column="1" Content="Actualizar" Click="Actualizar_Click"
                    Style="{StaticResource Mx.PrimaryButton}" VerticalAlignment="Top"/>
        </Grid>

        <!-- BÚSQUEDA Y FILTROS POR SITUACIÓN -->
        <Border Grid.Row="1" Style="{StaticResource Mx.Card}" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtBuscar" TextChanged="Buscar_TextChanged" Height="36"
                         Tag="Buscar caseta o titular"/>
                <WrapPanel x:Name="PanelFiltros" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- MAPA + DETALLE -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Mx.Card}" Padding="18,6,8,6" Margin="0,0,14,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PanelBloques" Margin="0,0,10,10"/>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Mx.Card}" Margin="0" VerticalAlignment="Top">
                <StackPanel x:Name="PanelDetalle">
                    <TextBlock Text="Selecciona una unidad" FontSize="16" FontWeight="SemiBold" Foreground="#12304D"/>
                    <TextBlock Text="Haz clic en un cuadro del mapa para ver su titular, lo que debe y cobrar desde aquí."
                               TextWrapping="Wrap" Foreground="#5A6B7D" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
