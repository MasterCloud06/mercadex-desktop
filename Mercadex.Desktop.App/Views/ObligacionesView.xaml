<UserControl x:Class="Mercadex.Desktop.App.Views.ObligacionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FA" FontFamily="Segoe UI" FontSize="14" Language="es-BO">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="18,16,18,20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="310"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TÍTULO -->

            <Grid Grid.Row="0"
                  Margin="0,0,0,18">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Generador de Cobranza"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="#173B5C"/>

                    <TextBlock Text="Registrar y generar obligaciones que posteriormente serán cobradas en Caja"
                               Foreground="#60748A"
                               FontSize="14"
                               Margin="0,4,0,0"/>

                </StackPanel>

                <Button Style="{StaticResource Mx.PrimaryButton}" Grid.Column="1"
                        Content="Actualizar"
                        Width="120"
                        Height="38"
                        Command="{Binding CargarCommand}"/>

            </Grid>

            <!-- OBLIGACIÓN INDIVIDUAL -->

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#DFE6EE"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,14"
                    Margin="0,0,0,16">

                <StackPanel>

                    <TextBlock Text="Registrar obligación individual"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#173B5C"
                               Margin="0,0,0,16"/>

                    <WrapPanel>

                        <StackPanel Margin="0,0,15,15">

                            <TextBlock Text="Caseta / Unidad *"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <ComboBox FontSize="14" BorderBrush="#C5D1DE" Width="160"
                                      Height="36"
                                      ItemsSource="{Binding Unidades}"
                                      SelectedItem="{Binding UnidadSeleccionada}"
                                      DisplayMemberPath="Codigo"/>

                        </StackPanel>

                        <StackPanel Margin="0,0,15,15">

                            <TextBlock Text="Concepto *"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <ComboBox FontSize="14" BorderBrush="#C5D1DE" Width="220"
                                      Height="36"
                                      ItemsSource="{Binding Conceptos}"
                                      SelectedItem="{Binding ConceptoSeleccionado}"
                                      DisplayMemberPath="Nombre"/>

                        </StackPanel>
                            <Button Style="{StaticResource Mx.SecondaryButton}" Content="+ Nuevo concepto"
                                    Command="{Binding NuevoConceptoCommand}"
                                    HorizontalAlignment="Left"
                                    Padding="10,5"
                                    Margin="0,8,0,0"/>

                        <StackPanel Margin="0,0,15,15">

                            <TextBlock Text="Monto *"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <TextBox Style="{StaticResource Mx.TextBox}" Width="120"
                                     Height="36"

                                     Text="{Binding MontoTexto,
                                         UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>

                        <StackPanel Margin="0,0,15,15">

                            <TextBlock Text="Moneda *"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <ComboBox FontSize="14" BorderBrush="#C5D1DE" Width="105"
                                      Height="36"
                                      ItemsSource="{Binding Monedas}"
                                      SelectedItem="{Binding MonedaSeleccionada}"
                                      DisplayMemberPath="Codigo"/>

                        </StackPanel>

                    </WrapPanel>

                    <WrapPanel>

                        <StackPanel Margin="0,0,15,15">

                            <TextBlock Text="Mes"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <ComboBox FontSize="14" BorderBrush="#C5D1DE" Width="95"
                                      Height="36"
                                      ItemsSource="{Binding Meses}"
                                      SelectedItem="{Binding MesSeleccionado}"/>

                        </StackPanel>

                        <StackPanel Margin="0,0,15,15">

                            <TextBlock Text="Año"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <ComboBox FontSize="14" BorderBrush="#C5D1DE" Width="105"
                                      Height="36"
                                      ItemsSource="{Binding Anios}"
                                      SelectedItem="{Binding AnioSeleccionado}"/>

                        </StackPanel>

                        <StackPanel Margin="0,0,15,15">

                            <TextBlock Text="Fecha de emisión"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <DatePicker FontSize="14" BorderBrush="#C5D1DE" Width="150"
                                        Height="36"
                                        SelectedDate="{Binding FechaEmision}"/>

                        </StackPanel>

                        <StackPanel Margin="0,0,15,15">

                            <TextBlock Text="Vencimiento"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <DatePicker FontSize="14" BorderBrush="#C5D1DE" Width="150"
                                        Height="36"
                                        SelectedDate="{Binding FechaVencimiento}"/>

                        </StackPanel>

                    </WrapPanel>

                    <StackPanel Orientation="Horizontal">

                        <Button Style="{StaticResource Mx.PrimaryButton}" Content="REGISTRAR OBLIGACIÓN"
                                Width="190"
                                Height="40"
                                Margin="0,0,10,0"
                                Command="{Binding RegistrarCommand}"
                                Background="#1F4E79"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"/>

                        <Button Style="{StaticResource Mx.SecondaryButton}" Content="Limpiar"
                                Width="100"
                                Height="40"
                                Command="{Binding LimpiarFormularioCommand}"/>

                    </StackPanel>

                </StackPanel>

            </Border>

            <!-- GENERACIÓN MASIVA -->

            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#D7B56D"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,14"
                    Margin="0,0,0,16">

                <StackPanel>

                    <TextBlock Text="Generación masiva mensual"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#8A5A00"/>

                    <TextBlock Text="Genera una obligación para todas las casetas activas. Las obligaciones ya existentes para ese período se omiten automáticamente."
                               Foreground="#6D6251"
                               TextWrapping="Wrap"
                               Margin="0,4,0,16"/>

                    <WrapPanel>
<WrapPanel Margin="0,0,0,12">

    <StackPanel Margin="0,0,15,0">

        <TextBlock Text="Aplicar a *"
                   FontWeight="SemiBold"
                   Margin="0,0,0,5"/>

        <ComboBox FontSize="14" BorderBrush="#C5D1DE" Width="190"
                  Height="36"
                  ItemsSource="{Binding AlcancesMasivo}"
                  SelectedItem="{Binding AlcanceMasivoSeleccionado}"/>

    </StackPanel>

    <StackPanel Margin="0,0,15,0">

        <TextBlock Text="Pasillo"
                   FontWeight="SemiBold"
                   Margin="0,0,0,5"/>

        <ComboBox FontSize="14" BorderBrush="#C5D1DE" Width="220"
                  Height="36"
                  ItemsSource="{Binding PasillosMasivo}"
                  SelectedItem="{Binding PasilloMasivoSeleccionado}"
                  DisplayMemberPath="Nombre"
                  IsEnabled="{Binding MostrarPasilloMasivo}"/>

    </StackPanel>

</WrapPanel>

                        <StackPanel Margin="0,0,15,15">

                            <TextBlock Text="Concepto *"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <ComboBox FontSize="14" BorderBrush="#C5D1DE" Width="230"
                                      Height="36"
                                      ItemsSource="{Binding Conceptos}"
                                      SelectedItem="{Binding ConceptoMasivoSeleccionado}"
                                      DisplayMemberPath="Nombre"/>

                        </StackPanel>

                        <StackPanel Margin="0,0,15,15">

                            <TextBlock Text="Monto por caseta *"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <TextBox Style="{StaticResource Mx.TextBox}" Width="140"
                                     Height="36"

                                     Text="{Binding MontoMasivoTexto,
                                         UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>

                        <StackPanel Margin="0,0,15,15">

                            <TextBlock Text="Moneda *"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <ComboBox FontSize="14" BorderBrush="#C5D1DE" Width="105"
                                      Height="36"
                                      ItemsSource="{Binding Monedas}"
                                      SelectedItem="{Binding MonedaMasivaSeleccionada}"
                                      DisplayMemberPath="Codigo"/>

                        </StackPanel>

                        <StackPanel Margin="0,0,15,15">

                            <TextBlock Text="Mes *"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <ComboBox FontSize="14" BorderBrush="#C5D1DE" Width="95"
                                      Height="36"
                                      ItemsSource="{Binding Meses}"
                                      SelectedItem="{Binding MesMasivoSeleccionado}"/>

                        </StackPanel>

                        <StackPanel Margin="0,0,15,15">

                            <TextBlock Text="Año *"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <ComboBox FontSize="14" BorderBrush="#C5D1DE" Width="105"
                                      Height="36"
                                      ItemsSource="{Binding Anios}"
                                      SelectedItem="{Binding AnioMasivoSeleccionado}"/>

                        </StackPanel>

                    </WrapPanel>

                    <WrapPanel>

                        <StackPanel Margin="0,0,15,15">

                            <TextBlock Text="Fecha de emisión"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <DatePicker FontSize="14" BorderBrush="#C5D1DE" Width="150"
                                        Height="36"
                                        SelectedDate="{Binding FechaEmisionMasiva}"/>

                        </StackPanel>

                        <StackPanel Margin="0,0,15,15">

                            <TextBlock Text="Vencimiento"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <DatePicker FontSize="14" BorderBrush="#C5D1DE" Width="150"
                                        Height="36"
                                        SelectedDate="{Binding FechaVencimientoMasiva}"/>

                        </StackPanel>

                    </WrapPanel>

                    <Border Background="#FFF8E8"
                            BorderBrush="#E8D39D"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="12"
                            Margin="0,0,0,14">

                        <StackPanel>

                            <TextBlock Text="{Binding ResumenMasivo}"
                                       FontWeight="SemiBold"
                                       Foreground="#76520D"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="{Binding ProgresoMasivo}"
                                       FontWeight="Bold"
                                       Foreground="#1F4E79"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>

                    <Button Style="{StaticResource Mx.PrimaryButton}" Content="GENERAR OBLIGACIONES"
                            Width="230"
                            Height="42"
                            HorizontalAlignment="Left"
                            Command="{Binding GenerarMasivoCommand}"
                            Background="#A66A00"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"/>

                </StackPanel>

            </Border>

            <!-- INDICADORES -->

            <UniformGrid Grid.Row="3"
                         Columns="3"
                         Margin="0,0,0,16">

                <Border Background="White"
                        BorderBrush="#DFE6EE"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,10,0">

                    <StackPanel>

                        <TextBlock Text="Total obligaciones"
                                   Foreground="#60748A"/>

                        <TextBlock Text="{Binding TotalObligaciones}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#173B5C"/>

                    </StackPanel>

                </Border>

                <Border Background="White"
                        BorderBrush="#DFE6EE"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,10,0">

                    <StackPanel>

                        <TextBlock Text="Pendientes"
                                   Foreground="#60748A"/>

                        <TextBlock Text="{Binding TotalPendientes}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#B36C14"/>

                    </StackPanel>

                </Border>

                <Border Background="White"
                        BorderBrush="#DFE6EE"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14">

                    <StackPanel>

                        <TextBlock Text="Monto pendiente"
                                   Foreground="#60748A"/>

                        <TextBlock Text="{Binding TotalPendienteMonto,
                            StringFormat=N2}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#B36C14"/>

                    </StackPanel>

                </Border>

            </UniformGrid>

            <!-- FILTROS -->

            <Border Grid.Row="4"
                    Background="White"
                    BorderBrush="#DFE6EE"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,0,12">

                <StackPanel>

                    <TextBlock Text="{Binding Mensaje}"
                               Foreground="#1F4E79"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <WrapPanel>

                        <StackPanel Margin="0,0,15,0">

                            <TextBlock Text="Buscar caseta o concepto"
                                       Margin="0,0,0,4"/>

                            <TextBox Style="{StaticResource Mx.TextBox}" Width="270"
                                     Height="36"
                                     Text="{Binding Busqueda,
                                         UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>

                        <StackPanel>

                            <TextBlock Text="Estado"
                                       Margin="0,0,0,4"/>

                            <ComboBox FontSize="14" BorderBrush="#C5D1DE" Width="150"
                                      Height="36"
                                      ItemsSource="{Binding Estados}"
                                      SelectedItem="{Binding EstadoSeleccionado}"/>

                        </StackPanel>

                    </WrapPanel>

                </StackPanel>

            </Border>

            <!-- TABLA -->

            <DataGrid Grid.Row="5" Style="{StaticResource Mx.DataGrid}"
                      ItemsSource="{Binding Obligaciones}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      RowHeight="36" HorizontalScrollBarVisibility="Auto"
                      AlternatingRowBackground="#F1F5FA"
                      GridLinesVisibility="Horizontal" VerticalScrollBarVisibility="Auto" FontSize="13" ColumnHeaderHeight="38">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Caseta"
                                        Binding="{Binding Unidad}"
                                        Width="75"/>

                    <DataGridTextColumn Header="Concepto"
                                        Binding="{Binding Concepto}"
                                        Width="195"
                                        MinWidth="180"/>

                    <DataGridTextColumn Header="Período"
                                        Binding="{Binding Periodo}"
                                        Width="85"/>

                    <DataGridTextColumn Header="Monto"
                                        Binding="{Binding Monto,
                                            StringFormat=N2}"
                                        Width="95"/>

                    <DataGridTextColumn Header="Moneda"
                                        Binding="{Binding Moneda}"
                                        Width="80"/>

                    <DataGridTextColumn Header="Emisión"
                                        Binding="{Binding FechaEmision,
                                            StringFormat=dd/MM/yyyy}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Vencimiento"
                                        Binding="{Binding Vencimiento}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Estado"
                                        Binding="{Binding Estado}"
                                        Width="105"/>

                </DataGrid.Columns>

            </DataGrid>

            <TextBlock Grid.Row="6"
                       Text="Las obligaciones pendientes quedan disponibles para su posterior cobro en Caja."
                       Foreground="#60748A"
                       FontStyle="Italic"
                       Margin="0,10,0,0"/>

        </Grid>

    </ScrollViewer>

</UserControl>