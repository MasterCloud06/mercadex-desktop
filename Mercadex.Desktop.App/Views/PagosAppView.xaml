<UserControl x:Class="Mercadex.Desktop.App.Views.PagosAppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Mx.Font}"
             FontSize="14"
             Background="#F3F6FA">

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Pagos por app" FontSize="27" FontWeight="Bold" Foreground="#12304D"/>
                <TextBlock x:Name="TxtEstado" Foreground="#5A6B7D" FontSize="13" Margin="0,3,0,0"
                           Text="Comprobantes que los socios enviaron desde la app. Revisa el depósito en el banco antes de aprobar."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ComboBox x:Name="CmbFiltro" Width="150" Height="38" Margin="0,0,10,0" SelectionChanged="Filtro_Changed">
                    <ComboBoxItem Content="Pendientes" Tag="pendiente" IsSelected="True"/>
                    <ComboBoxItem Content="Aprobados" Tag="aprobado"/>
                    <ComboBoxItem Content="Rechazados" Tag="rechazado"/>
                    <ComboBoxItem Content="Todos" Tag="todos"/>
                </ComboBox>
                <Button Content="Datos de pago de la app" Style="{StaticResource Mx.SecondaryButton}" Margin="0,0,10,0" Click="Configuracion_Click"/>
                <Button x:Name="BtnActualizar" Content="Actualizar" Style="{StaticResource Mx.PrimaryButton}" Click="Actualizar_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="Tabla" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      Margin="0,0,14,0" SelectionChanged="Tabla_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="130"/>
                    <DataGridTextColumn Header="Caseta" Binding="{Binding Caseta}" Width="80"/>
                    <DataGridTextColumn Header="Socio" Binding="{Binding Socio}" Width="*" MinWidth="160"/>
                    <DataGridTextColumn Header="Monto" Binding="{Binding MontoTexto}" Width="120">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Mx.ColumnHeaderRight}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Style="{StaticResource Mx.Card}" Margin="0" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PanelDetalle">
                        <TextBlock Text="Selecciona un pago" FontSize="16" FontWeight="SemiBold" Foreground="#12304D"/>
                        <TextBlock Text="Verás la foto del comprobante y podrás aprobarlo (se emite el recibo) o rechazarlo con un motivo."
                                   TextWrapping="Wrap" Foreground="#5A6B7D" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
