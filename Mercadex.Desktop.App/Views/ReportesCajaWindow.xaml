<Window x:Class="Mercadex.Desktop.App.Views.ReportesCajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mercadex - Reportes de caja"
        Width="1160"
        Height="790"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6FA"
        FontFamily="{StaticResource Mx.Font}">

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">

            <TextBlock Text="Reportes de caja"
                       FontSize="27"
                       FontWeight="Bold"
                       Foreground="#173B5C"/>

            <TextBlock
                Text="Recaudación diaria, períodos, conceptos y control de anulaciones"
                Foreground="#60748A"
                Margin="0,5,0,0"/>

        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#DFE6EE"
                BorderThickness="1"
                CornerRadius="9"
                Padding="15"
                Margin="0,0,0,12">

            <WrapPanel>

                <StackPanel Margin="0,0,14,8">
                    <TextBlock Text="Desde"/>
                    <DatePicker x:Name="FechaDesde"
                                Width="145"
                                Height="34"
                                SelectedDateFormat="Short"/>
                </StackPanel>

                <StackPanel Margin="0,0,14,8">
                    <TextBlock Text="Hasta"/>
                    <DatePicker x:Name="FechaHasta"
                                Width="145"
                                Height="34"
                                SelectedDateFormat="Short"/>
                </StackPanel>

                <Button Content="Hoy"
                        Width="95"
                        Height="34"
                        Margin="0,17,10,0"
                        Click="Hoy_Click"
                        Style="{StaticResource Mx.SecondaryButton}"/>

                <Button Content="Este mes"
                        Width="110"
                        Height="34"
                        Margin="0,17,10,0"
                        Click="Mes_Click"
                        Style="{StaticResource Mx.SecondaryButton}"/>

                <!-- Pago por grupo de bloques: un concepto y/o un bloque -->
                <StackPanel Margin="0,0,14,8">
                    <TextBlock Text="Concepto"/>
                    <ComboBox x:Name="CmbConcepto"
                              Width="220"
                              Height="34"
                              DisplayMemberPath="Nombre"
                              VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Margin="0,0,14,8">
                    <TextBlock Text="Bloque"/>
                    <ComboBox x:Name="CmbBloque"
                              Width="160"
                              Height="34"
                              VerticalContentAlignment="Center"/>
                </StackPanel>

                <Button x:Name="BtnConsultar"
                        Content="Consultar reporte"
                        Width="165"
                        Height="34"
                        Margin="0,17,0,0"
                        Click="Consultar_Click"
                        Style="{StaticResource Mx.PrimaryButton}"/>

            </WrapPanel>

        </Border>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DFE6EE"
                BorderThickness="1"
                CornerRadius="9"
                Padding="15"
                Margin="0,0,0,12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Recibos válidos"
                               Foreground="#60748A"/>

                    <TextBlock x:Name="TxtValidos"
                               Text="—"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#173B5C"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Anulaciones del período"
                               Foreground="#60748A"/>

                    <TextBlock x:Name="TxtAnulaciones"
                               Text="—"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#173B5C"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Recaudación válida por moneda"
                               Foreground="#60748A"/>

                    <TextBlock x:Name="TxtTotal"
                               Text="Sin consultar"
                               FontSize="17"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="#173B5C"/>
                </StackPanel>

            </Grid>

        </Border>

        <TabControl Grid.Row="3"
                    Background="White"
                    BorderBrush="#DFE6EE">

            <TabItem Header="Recaudación diaria">

                <DataGrid x:Name="TablaDias"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          AlternatingRowBackground="#F1F6FA">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha"
                                            Binding="{Binding Fecha}"
                                            Width="170"/>

                        <DataGridTextColumn Header="Moneda"
                                            Binding="{Binding Moneda}"
                                            Width="140"/>

                        <DataGridTextColumn Header="Recibos"
                                            Binding="{Binding CantidadRecibos}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Total del día"
                                            Binding="{Binding Total, StringFormat=N2}"
                                            Width="170"/>

                        <DataGridTextColumn Header="Acumulado del período"
                                            Binding="{Binding Acumulado, StringFormat=N2}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

            </TabItem>

            <TabItem Header="Formas de pago">

                <DataGrid x:Name="TablaFormas"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          AlternatingRowBackground="#F1F6FA">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Forma de pago"
                                            Binding="{Binding FormaPago}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Moneda"
                                            Binding="{Binding Moneda}"
                                            Width="180"/>

                        <DataGridTextColumn Header="Cantidad"
                                            Binding="{Binding Cantidad}"
                                            Width="150"/>

                        <DataGridTextColumn Header="Importe"
                                            Binding="{Binding Total, StringFormat=N2}"
                                            Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>

            </TabItem>

            <TabItem Header="Por concepto">

                <DataGrid x:Name="TablaConceptos"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          AlternatingRowBackground="#F1F6FA">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Concepto"
                                            Binding="{Binding Concepto}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Moneda"
                                            Binding="{Binding Moneda}"
                                            Width="150"/>

                        <DataGridTextColumn Header="Cantidad"
                                            Binding="{Binding Cantidad}"
                                            Width="130"/>

                        <DataGridTextColumn Header="Recaudado"
                                            Binding="{Binding Total, StringFormat=N2}"
                                            Width="170"/>
                    </DataGrid.Columns>
                </DataGrid>

            </TabItem>

            <TabItem Header="Detalle de cobros">

                <DataGrid x:Name="TablaCobros"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          AlternatingRowBackground="#F1F6FA">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Recibo"
                                            Binding="{Binding NumeroRecibo}"
                                            Width="85"/>

                        <DataGridTextColumn Header="Fecha"
                                            Binding="{Binding FechaBolivia}"
                                            Width="145"/>

                        <DataGridTextColumn Header="Caseta"
                                            Binding="{Binding Caseta}"
                                            Width="125"/>

                        <DataGridTextColumn Header="Pagador"
                                            Binding="{Binding Pagador}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Forma de pago"
                                            Binding="{Binding FormaPago}"
                                            Width="130"/>

                        <DataGridTextColumn Header="Moneda"
                                            Binding="{Binding Moneda}"
                                            Width="85"/>

                        <DataGridTextColumn Header="Importe"
                                            Binding="{Binding Monto, StringFormat=N2}"
                                            Width="110"/>

                        <DataGridTextColumn Header="Cobrado por"
                                            Binding="{Binding CobradoPorTexto}"
                                            Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>

            </TabItem>

            <TabItem Header="Anulaciones">

                <DataGrid x:Name="TablaAnulaciones"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          AlternatingRowBackground="#F1F6FA">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Recibo"
                                            Binding="{Binding NumeroRecibo}"
                                            Width="85"/>

                        <DataGridTextColumn Header="Fecha de anulación"
                                            Binding="{Binding FechaLocal}"
                                            Width="160"/>

                        <DataGridTextColumn Header="Importe excluido"
                                            Binding="{Binding MontoExcluido, StringFormat=N2}"
                                            Width="145"/>

                        <DataGridTextColumn Header="Moneda"
                                            Binding="{Binding Moneda}"
                                            Width="95"/>

                        <DataGridTextColumn Header="Motivo"
                                            Binding="{Binding Motivo}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Responsable"
                                            Binding="{Binding Responsable}"
                                            Width="155"/>
                    </DataGrid.Columns>
                </DataGrid>

            </TabItem>

        </TabControl>

        <Border Grid.Row="4"
                Background="White"
                BorderBrush="#DFE6EE"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,12,0,0">

            <DockPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">

                    <Button x:Name="BtnImprimir"
                            Content="Imprimir reporte / PDF"
                            Width="185"
                            Height="35"
                            IsEnabled="False"
                            Margin="0,0,10,0"
                            Click="Imprimir_Click"
                            Style="{StaticResource Mx.PrimaryButton}"/>

                    <Button Content="Cerrar"
                            Width="95"
                            Height="35"
                            Click="Cerrar_Click"
                            Style="{StaticResource Mx.SecondaryButton}"/>

                </StackPanel>

                <StackPanel Margin="0,0,15,0">

                    <TextBlock x:Name="TxtEstado"
                               Foreground="#375A77"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="Preparando consulta..."/>

                    <TextBlock
                        Text="Consulta informativa: no constituye cierre definitivo ni bloquea caja."
                        Foreground="#9B6415"
                        FontSize="11"
                        TextWrapping="Wrap"
                        Margin="0,4,0,0"/>

                </StackPanel>

            </DockPanel>

        </Border>

    </Grid>
</Window>