
<UserControl x:Class="Mercadex.Desktop.App.Views.ReportesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Mercadex.Desktop.App.Views" Background="#F3F6FA" FontFamily="{StaticResource Mx.Font}" FontSize="14" Language="es-BO">

    <Grid Background="#F3F6FA">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->

        <Border Grid.Row="0" Background="#F3F6FA" Padding="18,14" BorderBrush="#DFE6EE" BorderThickness="0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Reportes" FontSize="27" FontWeight="Bold" Foreground="#173B5C" />

                    <TextBlock Text="Listas de deudores para corte y contabilidad" FontSize="14" Foreground="#60748A" Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Reportes que antes estaban dentro de "Tarifas por caseta" -->
                    <Button Content="Caja por día" Click="ReportesCaja_Click" Height="40" Padding="14,0" Margin="0,0,8,0" Style="{StaticResource Mx.SecondaryButton}" ToolTip="Recaudación diaria, formas de pago, conceptos y anulaciones" />
                    <Button Content="Deudas consolidadas" Click="DeudasConsolidadas_Click" Height="40" Padding="14,0" Margin="0,0,8,0" Style="{StaticResource Mx.SecondaryButton}" ToolTip="Todas las deudas pendientes agrupadas por caseta" />
                    <Button Content="Comprobantes de anulación" Click="ComprobantesAnulacion_Click" Height="40" Padding="14,0" Margin="0,0,8,0" Style="{StaticResource Mx.SecondaryButton}" ToolTip="Recibos anulados: quién, cuándo y por qué" />
                    <Button Content="Actualizar" Click="Actualizar_Click" Width="125" Height="40" Background="#1F4E79" Foreground="White" Style="{StaticResource Mx.PrimaryButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- FILTROS -->

        <Border Grid.Row="1" Margin="18,8,18,12" Background="White" Padding="16,12" CornerRadius="11" BorderBrush="#DFE6EE" BorderThickness="1">

            <StackPanel>

                <TextBlock Text="Filtros del informe" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="#173B5C" />

                <WrapPanel>

                    <StackPanel Margin="0,0,16,10">
                        <TextBlock Text="Bloque" Margin="0,0,0,5" FontSize="13" FontWeight="SemiBold" Foreground="#4A5E73" />

                        <ComboBox x:Name="FiltroBloque" Width="155" Height="38" SelectionChanged="Filtros_Changed" FontSize="14" Background="White" BorderBrush="#C5D1DE" Padding="7,3" />
                    </StackPanel>

                    <StackPanel Margin="0,0,16,10">
                        <TextBlock Text="Concepto" Margin="0,0,0,5" FontSize="13" FontWeight="SemiBold" Foreground="#4A5E73" />

                        <ComboBox x:Name="FiltroConcepto" Width="185" Height="38" DisplayMemberPath="Nombre" SelectionChanged="Filtros_Changed" FontSize="14" Background="White" BorderBrush="#C5D1DE" Padding="7,3" />
                    </StackPanel>

                    <StackPanel Margin="0,0,16,10">
                        <TextBlock Text="Moneda" Margin="0,0,0,5" FontSize="13" FontWeight="SemiBold" Foreground="#4A5E73" />

                        <ComboBox x:Name="FiltroMoneda" Width="125" Height="38" SelectionChanged="Filtros_Changed" FontSize="14" Background="White" BorderBrush="#C5D1DE" Padding="7,3" />
                    </StackPanel>

                    <StackPanel Margin="0,0,16,10">
                        <TextBlock Text="Caseta" Margin="0,0,0,5" FontSize="13" FontWeight="SemiBold" Foreground="#4A5E73" />

                        <TextBox x:Name="FiltroCaseta" Width="115" Height="38" VerticalContentAlignment="Center" TextChanged="Caseta_Changed" Style="{StaticResource Mx.TextBox}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,16,10">
                        <TextBlock Text="Emitidas desde" Margin="0,0,0,5" FontSize="13" FontWeight="SemiBold" Foreground="#4A5E73" />

                        <DatePicker x:Name="FechaDesde" Width="170" Height="38" SelectedDateChanged="Fechas_Changed" FontSize="14" BorderBrush="#C5D1DE" />
                    </StackPanel>

                    <StackPanel Margin="0,0,16,10">
                        <TextBlock Text="Emitidas hasta" Margin="0,0,0,5" FontSize="13" FontWeight="SemiBold" Foreground="#4A5E73" />

                        <DatePicker x:Name="FechaHasta" Width="170" Height="38" SelectedDateChanged="Fechas_Changed" FontSize="14" BorderBrush="#C5D1DE" />
                    </StackPanel>

                </WrapPanel>

                <TextBlock x:Name="TxtEstado" Text="Cargando informes..." Foreground="#1F4E79" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />

            </StackPanel>

        </Border>

        <!-- RESUMEN -->

        <Border Grid.Row="2" Background="#E7F0F9" CornerRadius="9" Padding="14,11" Margin="18,0,18,12">

            <StackPanel>

                <TextBlock x:Name="TxtResumen" Text="Preparando resumen de deudores..." FontWeight="SemiBold" Foreground="#173B5C" TextWrapping="Wrap" />

                <TextBlock x:Name="TxtTotales" Margin="0,7,0,0" FontSize="18" FontWeight="Bold" Foreground="#287A42" TextWrapping="Wrap" />

            </StackPanel>

        </Border>

        <!-- INFORMES -->

        <TabControl x:Name="Pestanas" Grid.Row="3" Margin="18,0,18,18" Background="White" BorderBrush="#DFE6EE" BorderThickness="1">

            <!-- LISTA PARA CORTE -->

            <TabItem Header="Lista para corte" FontSize="13" FontWeight="SemiBold" Foreground="#173B5C" Padding="11,8">

                <Grid Background="White" Margin="12">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Cada caseta deudora aparece una sola vez, aunque tenga varias obligaciones." TextWrapping="Wrap" Foreground="#60748A" Margin="0,0,0,12" />

                    <DataGrid x:Name="TablaCorte" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" AlternatingRowBackground="#F1F5FA" Style="{StaticResource Mx.DataGrid}" RowHeight="36" ColumnHeaderHeight="38" FontSize="13" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanUserSortColumns="True" CanUserResizeColumns="True">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Caseta" Binding="{Binding Codigo}" Width="90" />

                            <DataGridTextColumn Header="Bloque" Binding="{Binding Bloque}" Width="135" />

                            <DataGridTextColumn Header="Servicios pendientes" Binding="{Binding Servicios}" Width="*" MinWidth="200" />

                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="85" />

                            <DataGridTextColumn Header="Moneda" Binding="{Binding Moneda}" Width="85" />

                            <DataGridTextColumn Header="Total" Binding="{Binding Total,&#xD;&#xA;                                    StringFormat=N2}" Width="115" />

                        </DataGrid.Columns>

                    </DataGrid>

                    <Button Grid.Row="2" Content="Exportar lista para corte" Click="ExportarCorte_Click" Height="40" Width="220" HorizontalAlignment="Right" Margin="0,12,0,0" Background="#287A42" Foreground="White" Style="{StaticResource Mx.PrimaryButton}" BorderBrush="#287A42" FontSize="13" />

                </Grid>

            </TabItem>

            <!-- LISTA PARA CONTABILIDAD -->

            <TabItem Header="Lista para contabilidad" FontSize="13" FontWeight="SemiBold" Foreground="#173B5C" Padding="11,8">

                <Grid Background="White" Margin="12">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Detalle de cada deuda pendiente, con importe individual y total por caseta y moneda." Foreground="#60748A" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <DataGrid x:Name="TablaContabilidad" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" AlternatingRowBackground="#F1F5FA" Style="{StaticResource Mx.DataGrid}" RowHeight="36" ColumnHeaderHeight="38" FontSize="13" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanUserSortColumns="True" CanUserResizeColumns="True">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Caseta" Binding="{Binding Codigo}" Width="75" />

                            <DataGridTextColumn Header="Bloque" Binding="{Binding Bloque}" Width="100" />

                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="110" />

                            <DataGridTextColumn Header="Servicio" Binding="{Binding Concepto}" Width="*" MinWidth="140" />

                            <DataGridTextColumn Header="Período" Binding="{Binding Periodo}" Width="85" />

                            <DataGridTextColumn Header="Moneda" Binding="{Binding Moneda}" Width="75" />

                            <DataGridTextColumn Header="Importe" Binding="{Binding Monto,&#xD;&#xA;                                    StringFormat=N2}" Width="100" />

                            <DataGridTextColumn Header="Total caseta" Binding="{Binding TotalCaseta,&#xD;&#xA;                                    StringFormat=N2}" Width="115" />

                        </DataGrid.Columns>

                    </DataGrid>

                    <Button Grid.Row="2" Content="Exportar para contabilidad" Click="ExportarContabilidad_Click" Height="40" Width="225" HorizontalAlignment="Right" Margin="0,12,0,0" Background="#287A42" Foreground="White" Style="{StaticResource Mx.PrimaryButton}" BorderBrush="#287A42" FontSize="13" />

                </Grid>

            </TabItem>


            <TabItem Header="Ingresos recaudados" FontSize="13" FontWeight="SemiBold" Foreground="#173B5C" Padding="11,8">
                <views:ReportesIngresosView />
            </TabItem>

<TabItem Header="Extracto de deuda" FontSize="13" FontWeight="SemiBold" Foreground="#173B5C" Padding="11,8">
    <views:ExtractoDeudaView />
</TabItem>

            <TabItem Header="Aviso para corte" FontSize="13" FontWeight="SemiBold" Foreground="#173B5C" Padding="11,8">
                <views:AvisoCorteView />
            </TabItem>

            <TabItem Header="Ingresos y gastos" FontSize="13" FontWeight="SemiBold" Foreground="#173B5C" Padding="11,8">
                <views:InformeIngresosGastosView />
            </TabItem>

            <TabItem x:Name="TabAnularCobro" Header="Anular cobro" FontSize="13" FontWeight="SemiBold" Foreground="#173B5C" Padding="11,8">
                <views:AnularCobroView />
            </TabItem>
</TabControl>

    </Grid>

</UserControl>
