<UserControl x:Class="Mercadex.Desktop.App.Views.SociosView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F3F6FA" FontFamily="Segoe UI" FontSize="14" Language="es-BO">

    <Grid Margin="18,16,18,18">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->

        <Grid Grid.Row="0" Margin="0,0,0,14">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="Gestión de Socios" FontSize="27" FontWeight="Bold" Foreground="#173B5C" />

                <TextBlock Text="Registro, búsqueda y consulta de socios" FontSize="13" Foreground="#60748A" Margin="0,4,0,0" />

            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding Resumen}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#1F4E79" />

        </Grid>

        <!-- FORMULARIO -->

        <Border Grid.Row="1" Background="White" BorderBrush="#DFE6EE" BorderThickness="1" CornerRadius="11" Padding="16,14" Margin="0,0,0,12">

            <StackPanel>

                <TextBlock Text="Registrar nuevo socio" FontSize="18" FontWeight="SemiBold" Foreground="#173B5C" Margin="0,0,0,12" />

                <WrapPanel>

                    <StackPanel Margin="0,0,16,10">

                        <TextBlock Text="Nombres *" FontWeight="SemiBold" Margin="0,0,0,6" FontSize="13" Foreground="#4A5E73" />

                        <TextBox Width="210" Height="38" Text="{Binding Nombres,&#xD;&#xA;                                 UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Mx.TextBox}" FontSize="14" />

                    </StackPanel>

                    <StackPanel Margin="0,0,16,10">

                        <TextBlock Text="Apellidos *" FontWeight="SemiBold" Margin="0,0,0,6" FontSize="13" Foreground="#4A5E73" />

                        <TextBox Width="210" Height="38" Text="{Binding Apellidos,&#xD;&#xA;                                 UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Mx.TextBox}" FontSize="14" />

                    </StackPanel>

                    <StackPanel Margin="0,0,16,10">

                        <TextBlock Text="Documento de identidad *" FontWeight="SemiBold" Margin="0,0,0,6" FontSize="13" Foreground="#4A5E73" />

                        <TextBox Width="190" Height="38" Text="{Binding DocumentoIdentidad,&#xD;&#xA;                                 UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Mx.TextBox}" FontSize="14" />

                    </StackPanel>

                    <StackPanel Margin="0,0,16,10">

                        <TextBlock Text="Teléfono" FontWeight="SemiBold" Margin="0,0,0,6" FontSize="13" Foreground="#4A5E73" />

                        <TextBox Width="180" Height="38" Text="{Binding Telefono,&#xD;&#xA;                                 UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Mx.TextBox}" FontSize="14" />

                    </StackPanel>

                </WrapPanel>

                <StackPanel Orientation="Horizontal">

                    <Button Content="Guardar socio" Width="145" Height="38" Margin="0,0,10,0" Command="{Binding GuardarCommand}" Style="{StaticResource Mx.PrimaryButton}" FontSize="14" />

                    <Button Content="Limpiar" Width="105" Height="38" Command="{Binding LimpiarCommand}" Style="{StaticResource Mx.SecondaryButton}" FontSize="14" />

                </StackPanel>

            </StackPanel>

        </Border>

        <!-- BUSCADOR -->

        <Border Grid.Row="2" Background="White" BorderBrush="#DFE6EE" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Height="38" Margin="0,0,12,0" Text="{Binding TextoBusqueda,&#xD;&#xA;                         UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar por nombre, documento o teléfono" Style="{StaticResource Mx.TextBox}" FontSize="14" />

                <CheckBox Grid.Column="1" Content="Solo activos" IsChecked="{Binding SoloActivos}" VerticalAlignment="Center" Margin="0,0,18,0" FontSize="13" Foreground="#31465A" />

                <Button Grid.Column="2" Content="Actualizar" Width="110" Height="38" Margin="0,0,8,0" Command="{Binding ConsultarCommand}" Style="{StaticResource Mx.PrimaryButton}" FontSize="14" />

                <Button Grid.Column="3" Content="Quitar filtros" Width="125" Height="38" Command="{Binding LimpiarBusquedaCommand}" Style="{StaticResource Mx.SecondaryButton}" FontSize="14" />

            </Grid>

        </Border>

        <!-- TABLA -->

        <DataGrid Grid.Row="3" ItemsSource="{Binding Socios}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Background="White" BorderBrush="#DCE3EA" BorderThickness="1" RowHeight="38" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Style="{StaticResource Mx.DataGrid}" ColumnHeaderHeight="40" MinHeight="180" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Nombre completo" Binding="{Binding NombreCompleto}" Width="2*" MinWidth="230" />

                <DataGridTextColumn Header="Documento" Binding="{Binding DocumentoIdentidad}" Width="150" />

                <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="140" />

                <DataGridTextColumn Header="Fecha de registro" Binding="{Binding FechaRegistro,&#xD;&#xA;                                    StringFormat=dd/MM/yyyy HH:mm}" Width="175" />

                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="85" />

            </DataGrid.Columns>

        </DataGrid>

        <!-- ESTADO -->

        <Border Grid.Row="4" Margin="0,12,0,0" Padding="12,10" Background="#E7F0F9" CornerRadius="8">

            <TextBlock Text="{Binding Mensaje}" Foreground="#1F4E79" FontSize="14" TextWrapping="Wrap" />

        </Border>

    </Grid>

</UserControl>